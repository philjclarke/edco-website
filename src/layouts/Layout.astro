---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { repositoryName } from '@/lib/prismic';
import { pagePath } from '@/lib/content';

interface Props {
  title: string;
  description?: string;
  /** Dark headers sit on dark heroes; light headers on white pages. */
  headerTone?: 'dark' | 'light';
}

const { title, description = '', headerTone = 'dark' } = Astro.props;
const fullTitle = title === 'home' ? 'The Education Company' : `${title} | EdCo`;
const canonical = new URL(pagePath(Astro.locals, Astro.url), Astro.site);
// A Prismic draft preview: kept out of search engines, with Prismic's toolbar
// (which reloads when a draft is saved) and a bar saying it isn't the live site.
const preview = Astro.locals.prismicPreview;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="The Education Company" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    {preview && <script is:inline async defer src={`https://static.cdn.prismic.io/prismic.js?new=true&repo=${repositoryName}`} />}

    <!-- PROVISIONAL webfonts. Swap for the licensed EdCo face and self-host. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap"
    />

    <!-- Per-page additions: a robots directive, structured data, a preload. -->
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-navy-900 focus:px-4 focus:py-2 focus:text-ondark"
      >Skip to content</a
    >
    {
      preview && (
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 bg-orange px-4 py-2 text-center text-[13px] font-semibold text-navy-900">
          <span>Preview: draft content from Prismic, not the live site</span>
          <a href={`/api/exit-preview?to=${encodeURIComponent(preview.path)}`} class="underline">Exit preview</a>
        </div>
      )
    }
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
