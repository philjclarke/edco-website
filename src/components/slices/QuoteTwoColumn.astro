---
/*
  Quote, two-column variation: a header on the left, the quote in a card on
  the right, client logos underneath if switched on. With no quote yet it
  shows the mock testimonial for its theme (see Testimonial.astro).
*/
import type { Slice } from '@prismicio/client';
import Section from '../Section.astro';
import Testimonial from '../Testimonial.astro';
import LogoWall from '../LogoWall.astro';
import { textOf } from '@/lib/prismic';
import { toneOf } from '../sections/tone';

const { slice } = Astro.props as { slice: Slice };
const p = slice.primary as Record<string, any>;
const quote = textOf(p.text);
const name = textOf(p.name);
const role = textOf(p.footer);
// Grey by default; the quote's card is white, or raised navy on navy.
const tone = toneOf(p.background ?? 'grey');
const dark = tone === 'dark';
---

<Section tone={tone} size="md">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-center">
    <div>
      {textOf(p.eyebrow) && <p class="eyebrow grad-text mb-4">{textOf(p.eyebrow)}</p>}
      {textOf(p.header) && <h2 class="text-title">{textOf(p.header)}</h2>}
    </div>
    {
      quote ? (
        <figure
          class:list={[
            'rounded-card border p-7 md:p-8',
            dark ? 'border-navy-700 bg-navy-800' : 'border-line bg-paper',
          ]}
        >
          <div class="h-1 w-12 rounded-full grad-rule" />
          <blockquote class="mt-5 font-display text-subtitle">
            <p>“{quote.replace(/^[“"]|[”"]$/g, '')}”</p>
          </blockquote>
          {(name || role) && (
            <figcaption class:list={['mt-5 text-sm', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
              {name && <span class:list={['font-semibold', dark ? 'text-ondark' : 'text-ink']}>{name}</span>}
              {role && <span class="block">{role}</span>}
            </figcaption>
          )}
        </figure>
      ) : (
        <Testimonial prompt={textOf(p.theme) || 'working with EdCo'} tone={dark ? 'dark' : 'light'} />
      )
    }
  </div>
  {
    p.show_logos && (
      <div class="mt-12">
        <LogoWall tone={dark ? 'dark' : 'light'} />
      </div>
    )
  }
</Section>
