---
/*
  Contact form: the enquiry form, with what happens next and the phone number
  beside it. Brief §68: the whole contact journey is one question, what are
  you trying to achieve? Nothing compulsory beyond name, work email and
  organisation — no phone number, budget, job title, company size, timeframe,
  or "how did you hear about us". The purpose is to begin a conversation, not
  interrogate.

  The wording is the editor's; the fields stay in code, since the form's
  handler (not yet connected) depends on them. The tick boxes are the
  outcome pages, in menu order.
*/
import type { Slice } from '@prismicio/client';
import Section from '../Section.astro';
import Placeholder from '../Placeholder.astro';
import { outcomes } from '@/data/outcomes';
import { contact } from '@/data/site';
import { richHTML, textOf } from '@/lib/prismic';

const { slice } = Astro.props as { slice: Slice };
const p = slice.primary as Record<string, any>;
const t = (k: string, fallback: string) => textOf(p[k]) || fallback;
const nextHTML = richHTML(p.next_text);
const customersHTML = richHTML(p.customers_text);

const field =
  'w-full rounded-xl border border-line bg-paper px-4 py-3 text-[0.9375rem] transition placeholder:text-ink-muted/60 focus:border-orange';
---

<Section tone="light" size="lg">
  <div class="grid gap-14 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-20">
    <form id="objective-form" novalidate>
      <fieldset>
        <legend class="font-display text-title font-bold">{t('heading', 'What are you trying to achieve?')}</legend>
        {textOf(p.intro) && <p class="mt-3 text-ink-muted">{textOf(p.intro)}</p>}
        <ul class="mt-7 grid gap-3 sm:grid-cols-2">
          {
            outcomes.map((o) => (
              <li>
                <label class="flex h-full cursor-pointer items-start gap-3 rounded-card border border-line bg-paper p-4 transition hover:border-ink/25 has-[:checked]:border-pink has-[:checked]:bg-pink/5">
                  <input type="checkbox" name="objective" value={o.slug} class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-pink)]" />
                  <span class="font-display text-[0.9375rem] font-semibold leading-snug">{o.navLabel}</span>
                </label>
              </li>
            ))
          }
          <li class="sm:col-span-2">
            <label class="flex cursor-pointer items-start gap-3 rounded-card border border-line bg-paper p-4 transition hover:border-ink/25 has-[:checked]:border-pink has-[:checked]:bg-pink/5">
              <input type="checkbox" name="objective" value="customer-analysis" class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-pink)]" />
              <span class="font-display text-[0.9375rem] font-semibold leading-snug">
                {t('analysis_option', 'I’d like the free customer analysis')}
              </span>
            </label>
          </li>
        </ul>
      </fieldset>

      <div class="mt-12">
        <label for="more" class="block font-display text-title font-bold">{t('more_heading', 'Tell us a little more')}</label>
        {textOf(p.more_intro) && <p class="mt-3 text-ink-muted">{textOf(p.more_intro)}</p>}
        <textarea id="more" name="more" rows="5" class:list={[field, 'mt-5']}></textarea>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <h2 class="text-title">{t('details_heading', 'And who are you?')}</h2>
        </div>
        <div>
          <label for="name" class="mb-2 block text-sm font-medium">Name</label>
          <input id="name" name="name" autocomplete="name" required class={field} />
        </div>
        <div>
          <label for="org" class="mb-2 block text-sm font-medium">Organisation</label>
          <input id="org" name="organisation" autocomplete="organization" required class={field} />
        </div>
        <div class="sm:col-span-2">
          <label for="email" class="mb-2 block text-sm font-medium">Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
        </div>
      </div>

      <div class="mt-10">
        <button
          type="submit"
          class="w-full rounded-full bg-[linear-gradient(96deg,var(--color-orange),var(--color-pink))] px-7 py-3.5 font-display text-base font-semibold text-white transition hover:brightness-110 sm:w-auto"
          >{t('button_label', 'Start the conversation')}</button
        >
      </div>
      <div class="mt-6 space-y-2">
        <Placeholder label="FORM ENDPOINT" note="no CRM or form handler connected yet" block />
        <Placeholder label="PRIVACY NOTICE / CONSENT WORDING" note="legal sign-off required" block />
      </div>
    </form>

    <aside class="lg:pt-4">
      {
        (textOf(p.next_heading) || nextHTML) && (
          <div class="rounded-card border border-line bg-mist p-7">
            {textOf(p.next_heading) && <h2 class="text-title">{textOf(p.next_heading)}</h2>}
            <div class="prose-edco mt-4 text-ink-muted" set:html={nextHTML} />
          </div>
        )
      }

      <div class="mt-8">
        <h2 class="text-title">{t('phone_heading', 'Or just ring us')}</h2>
        <p class="mt-4">
          <a href={contact.phoneHref} class="font-display text-xl font-semibold grad-text">{contact.phone}</a>
        </p>
        <address class="mt-6 text-sm not-italic text-ink-muted">
          {contact.address.map((line) => <span class="block">{line}</span>)}
        </address>
        <p class="mt-4">
          <Placeholder label="GENERAL EMAIL ADDRESS" />
        </p>
      </div>

      {
        (textOf(p.customers_heading) || customersHTML) && (
          <div class="mt-8 rounded-card border border-line p-7">
            {textOf(p.customers_heading) && <h2 class="font-display text-base font-semibold">{textOf(p.customers_heading)}</h2>}
            <div class="prose-edco mt-3 text-sm text-ink-muted" set:html={customersHTML} />
          </div>
        )
      }
    </aside>
  </div>
</Section>

<script>
  // Deep links such as /contact/?intent=customer-analysis pre-tick the matching
  // objective, so a CTA elsewhere on the site carries its context into the form.
  const intent = new URLSearchParams(location.search).get('intent');
  if (intent) {
    const box = document.querySelector<HTMLInputElement>(
      `#objective-form input[name="objective"][value="${CSS.escape(intent)}"]`
    );
    if (box) box.checked = true;
  }
</script>
