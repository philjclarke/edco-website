---
/*
  Content listing, in three variations:
    Chosen — a card for each picked page.
    Latest — the newest insights, opinion or case studies, filled in
             automatically. "How many" is the most that show; there are
             never empty slots. With "Show every article" on, it's how
             many show before a Show more button, and filter buttons
             can narrow the list by type. With nothing to show, it is left out.
    Links  — a compact list of links ("You might also be interested in").
  Every card is filled from its page's Preview tab.
*/
import type { Slice } from '@prismicio/client';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';
import NextSteps from '../NextSteps.astro';
import PreviewCard from '../PreviewCard.astro';
import FadedPhoto from '../FadedPhoto.astro';
import { hrefOf, imageOf, textOf } from '@/lib/prismic';
import { pages, type PageContext, type PagePreview } from '@/lib/pages';
import { toneOf } from '../sections/tone';

interface Props {
  slice: Slice;
  context?: PageContext;
}
const { slice, context } = Astro.props;
const p = slice.primary as Record<string, any>;
const tone = toneOf(p.background);
const dark = tone === 'dark';
const all = await pages(Astro.locals);
const photo = imageOf(p.photo);

const SHOW: Record<string, { types: string[]; label: string }> = {
  'Insights and opinion': { types: ['insight', 'opinion'], label: 'insights and opinion' },
  Insights: { types: ['insight'], label: 'insight' },
  Opinion: { types: ['opinion'], label: 'opinion' },
  'Case studies': { types: ['case_study'], label: 'case study' },
};

// Filter buttons, in this order, for the types that have something to show.
const TYPES: Record<string, { id: string; label: string }> = {
  insight: { id: 'insights', label: 'Insights' },
  opinion: { id: 'opinion', label: 'Opinion' },
  case_study: { id: 'case-studies', label: 'Case studies' },
};

let cards: (PagePreview & { kind?: string })[] = [];
let pageSize = 0;
let filters: { id: string; label: string }[] = [];
let links: { label: string; href: string; blurb?: string; icon?: string }[] = [];
const show = SHOW[p.show] ?? SHOW['Insights and opinion'];

if (slice.variation === 'links') {
  links = (p.items ?? [])
    .map((x: any) => {
      const href = hrefOf(x.page);
      if (!href) return null;
      const doc = all.linked(x.page);
      const target = doc ? all.preview(doc) : undefined;
      return {
        href,
        label: textOf(x.label) || target?.title || 'Find out more',
        blurb: textOf(x.blurb) || target?.text || undefined,
        icon: target?.icon,
      };
    })
    .filter(Boolean);
} else if (slice.variation === 'latest') {
  const when = (pg: PagePreview, d: any) => pg.article?.date?.getTime() ?? new Date(d.first_publication_date).getTime();
  const found = all.docs
    .filter((d) => show.types.includes(d.type) && d.id !== context?.id)
    .map((d) => ({ pg: { ...all.preview(d), kind: TYPES[d.type]?.id }, t: when(all.preview(d), d) }))
    .sort((a, b) => b.t - a.t)
    .map((x) => x.pg);
  const count = Number(p.count) || 0;
  if (p.everything) {
    cards = found;
    pageSize = count || 9;
  } else {
    cards = count ? found.slice(0, count) : found;
  }
  const kinds = Object.values(TYPES).filter((t) => cards.some((c) => c.kind === t.id));
  if (p.filters && kinds.length > 1) filters = [{ id: 'all', label: 'All' }, ...kinds];
} else {
  cards = (p.items ?? []).map((x: any) => all.linked(x.page)).filter(Boolean).map((d: any) => all.preview(d));
}
const button = hrefOf(p.button_link);
// A Latest listing with nothing to show yet leaves no trace on the page.
const empty = slice.variation === 'latest' && cards.length === 0;
---

{
  empty ? null : slice.variation === 'links' ? (
    <Section tone={tone} size="md">
      <NextSteps title={textOf(p.heading) || 'Where might you go next?'} links={links} icons={p.icons !== false} tone={dark ? 'dark' : 'light'} />
    </Section>
  ) : (
    <Section tone={tone} size="lg" class="isolate overflow-hidden">
      {photo && <FadedPhoto image={photo} />}
      {(textOf(p.heading) || button) && (
        <div class="flex flex-wrap items-end justify-between gap-6">
          {textOf(p.heading) && (
            <SectionHead eyebrow={textOf(p.eyebrow) || undefined} title={textOf(p.heading)} lead={textOf(p.intro) || undefined} tone={dark ? 'dark' : 'light'} class="flex-1" />
          )}
          {button && textOf(p.button_label) && <Button href={button} variant={dark ? 'ghost-dark' : 'ghost'}>{textOf(p.button_label)}</Button>}
        </div>
      )}
      {
        filters.length > 0 && (
          <div
            data-filters
            hidden
            role="group"
            aria-label="Show"
            class:list={['flex flex-wrap gap-2', (textOf(p.heading) || button) ? 'mt-10' : '']}
          >
            {filters.map((f, i) => (
              <button
                type="button"
                data-filter={f.id}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class:list={[
                  'rounded-full border px-4 py-2 font-display text-sm font-semibold transition',
                  dark
                    ? 'border-navy-600 text-ondark hover:border-orange aria-pressed:border-white aria-pressed:bg-white aria-pressed:text-navy-900'
                    : 'border-line text-ink hover:border-ink aria-pressed:border-navy-900 aria-pressed:bg-navy-900 aria-pressed:text-ondark',
                ]}
              >
                {f.label}
              </button>
            ))}
          </div>
        )
      }
      <ul
        data-listing={pageSize || filters.length ? '' : undefined}
        data-page-size={pageSize || undefined}
        class:list={[
          'grid gap-5 md:grid-cols-2 lg:grid-cols-3',
          filters.length ? 'mt-8' : (textOf(p.heading) || button) && 'mt-12',
        ]}
      >
        {cards.map((c, i) => (
          <li data-kind={c.kind} hidden={pageSize > 0 && i >= pageSize}>
            <PreviewCard page={c} tone={dark ? 'dark' : 'light'} />
          </li>
        ))}
      </ul>
      {
        pageSize > 0 && cards.length > pageSize && (
          <div class="mt-10 flex justify-center">
            <button
              type="button"
              data-more
              class:list={[
                'inline-flex items-center justify-center rounded-full border px-5 py-3 font-display text-sm font-semibold transition',
                dark ? 'border-navy-600 text-ondark hover:border-orange hover:text-orange' : 'border-line text-ink hover:border-ink hover:bg-mist',
              ]}
            >
              Show more
            </button>
          </div>
        )
      }
    </Section>
  )
}

<script>
  // Filter buttons and Show more. Without JavaScript the first page of cards
  // shows and the buttons stay hidden. The chosen filter goes in the address
  // (e.g. #opinion) so a filtered view can be shared.
  for (const list of document.querySelectorAll<HTMLElement>('[data-listing]')) {
    const section = list.parentElement!;
    const bar = section.querySelector<HTMLElement>('[data-filters]');
    const buttons = [...(bar?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [])];
    const more = section.querySelector<HTMLButtonElement>('[data-more]');
    const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
    const size = Number(list.dataset.pageSize) || Infinity;
    let filter = 'all';
    let shown = size;

    const render = () => {
      const matching = items.filter((li) => filter === 'all' || li.dataset.kind === filter);
      for (const li of items) li.hidden = true;
      matching.slice(0, shown).forEach((li) => (li.hidden = false));
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      if (more) more.parentElement!.hidden = matching.length <= shown;
    };

    const fromHash = location.hash.slice(1);
    if (buttons.some((b) => b.dataset.filter === fromHash)) filter = fromHash;
    if (bar) bar.hidden = false;
    for (const b of buttons) {
      b.addEventListener('click', () => {
        filter = b.dataset.filter!;
        shown = size;
        history.replaceState(null, '', filter === 'all' ? location.pathname + location.search : `#${filter}`);
        render();
      });
    }
    more?.addEventListener('click', () => {
      const first = items.filter((li) => li.hidden && (filter === 'all' || li.dataset.kind === filter))[0];
      shown += size;
      render();
      first?.querySelector('a')?.focus();
    });
    render();
  }
</script>
