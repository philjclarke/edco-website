---
/* Figures: a heading and text, with a row of figures: the component's own, or else the proof figures from Site settings. */
import Section from '../Section.astro';
import StatGrid from '../StatGrid.astro';
import { richHTML, textOf } from '@/lib/prismic';
import { withPlaceholders } from '@/lib/placeholders';
import { siteSettings } from '@/lib/content';
import { toneOf } from './tone';

const { p } = Astro.props as { p: Record<string, any> };
const tone = toneOf(p.background);
const dark = tone === 'dark';
const own = ((p.figures ?? []) as any[])
  .filter((f) => textOf(f.value))
  .map((f) => ({ value: textOf(f.value), label: textOf(f.label), verified: f.verified !== false }));
const stats = own.length ? own : (await siteSettings(Astro.locals)).proofStats;
---

<Section tone={tone} size="lg">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      {textOf(p.eyebrow) && <p class="eyebrow grad-text mb-4">{textOf(p.eyebrow)}</p>}
      <h2 class="text-display">{textOf(p.heading)}</h2>
    </div>
    <div class:list={['text-lead space-y-5', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
      <Fragment set:html={withPlaceholders(richHTML(p.body))} />
    </div>
  </div>
  <div class="mt-14">
    <StatGrid stats={stats} tone={dark ? 'dark' : 'light'} />
  </div>
</Section>
