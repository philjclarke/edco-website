---
/* Statement: a big heading on the left, paragraphs on the right (homepage "partners, not vendors"). */
import Section from '../Section.astro';
import { richHTML, textOf } from '@/lib/prismic';
import { withPlaceholders } from '@/lib/placeholders';
import { toneOf } from './tone';

const { p } = Astro.props as { p: Record<string, any> };
const tone = toneOf(p.background);
const dark = tone === 'dark';
---

<Section tone={tone} size="lg">
  <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-20">
    <div>
      {textOf(p.eyebrow) && <p class="eyebrow grad-text mb-4">{textOf(p.eyebrow)}</p>}
      <h2 class="text-display">{textOf(p.heading)}</h2>
    </div>
    <div class:list={['text-lead space-y-5', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
      <Fragment set:html={withPlaceholders(richHTML(p.body))} />
      {textOf(p.closing_line) && (
        <p class:list={['font-display font-semibold', dark ? 'text-ondark' : 'text-ink']}>{textOf(p.closing_line)}</p>
      )}
    </div>
  </div>
</Section>
