---
/* Latest articles (deprecated): replaced by Content listing → Latest, which renders it. */
import ContentListing from '../slices/ContentListing.astro';

const { p } = Astro.props as { p: Record<string, any> };
const show = p.stream === 'Insights' || p.stream === 'Opinion' ? p.stream : 'Insights and opinion';
---

<ContentListing slice={{ slice_type: 'content_listing', variation: 'latest', primary: { ...p, show }, items: [] } as any} />
