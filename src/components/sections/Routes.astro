---
/* Routes: each outcome's objective and the products and capabilities its How we do it picks (brief §71). */
import Section from '../Section.astro';
import RouteSteps from '../RouteSteps.astro';
import { textOf } from '@/lib/prismic';
import { routes } from '@/data/model';
import { toneOf } from './tone';

const { p } = Astro.props as { p: Record<string, any> };
const tone = toneOf(p.background);
const dark = tone === 'dark';
---

<Section tone={tone} size="lg">
  {textOf(p.heading) && <h2 class="text-title">{textOf(p.heading)}</h2>}
  <ul class:list={['mt-12 space-y-px overflow-hidden rounded-card border', dark ? 'border-navy-700 bg-navy-700' : 'border-line bg-line']}>
    {
      routes.map((r) => (
        <li class:list={['p-6 md:p-8', dark ? 'bg-navy-800' : 'bg-paper']}>
          <p class="font-display text-subtitle font-semibold">“{r.objective}”</p>
          <div class="mt-5">
            <RouteSteps steps={r.steps} hrefs={r.stepHrefs} tone={dark ? 'dark' : 'light'} />
          </div>
        </li>
      ))
    }
  </ul>
  {textOf(p.closing) && <p class:list={['mt-8 max-w-2xl', dark ? 'text-ondark-muted' : 'text-ink-muted']}>{textOf(p.closing)}</p>}
</Section>
