---
import Placeholder from './Placeholder.astro';

interface Stat {
  value: string;
  label: string;
  /** Brief §76: nothing goes live until EdCo confirm it. */
  verified?: boolean;
}
interface Props {
  stats: Stat[];
  tone?: 'dark' | 'light';
}
const { stats, tone = 'dark' } = Astro.props;
const dark = tone === 'dark';
// As many columns as figures, up to four, so a row never ends in an empty cell.
const cols = { 1: '', 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-3' }[stats.length] ?? (stats.length % 3 === 0 ? 'sm:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-4');
---

<dl class:list={['grid gap-px overflow-hidden rounded-card border', cols, dark ? 'border-navy-700 bg-navy-700' : 'border-line bg-line']}>
  {
    stats.map((s) => (
      <div class:list={['flex flex-col p-6 md:p-8', dark ? 'bg-navy-800' : 'bg-paper']}>
        <dt class:list={['order-2 mt-2 text-sm', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
          {s.label}
        </dt>
        <dd class="order-1 font-display text-3xl font-bold md:text-4xl">
          <span class="grad-text">{s.value}</span>
        </dd>
        {!s.verified && (
          <p class="order-3 mt-3">
            <Placeholder label="VERIFY" note="figure not yet confirmed" />
          </p>
        )}
      </div>
    ))
  }
</dl>
