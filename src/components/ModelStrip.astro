---
/*
  Brief §5: LISTEN → UNDERSTAND → GIVE → ENGAGE → BUILD → GROW is the
  conceptual model underpinning the whole site. Nothing here is a link, so it
  is a Grid, not a set of panels.
*/
import { Icon } from 'astro-icon/components';
import Grid from './Grid.astro';
import { edcoModel } from '@/data/model';

interface Props {
  tone?: 'dark' | 'light';
  compact?: boolean;
}
const { tone = 'dark', compact = false } = Astro.props;
const dark = tone === 'dark';
---

<Grid cols={3} tone={tone} as="ol">
  {
    edcoModel.map((step, i) => (
      <li class="p-6 md:p-7">
        {/* The icon sits above the heading, matching the panel variant — on the
            line it competed with the numeral. */}
        {step.icon && (
          <Icon
            name={step.icon}
            class:list={['mb-4 h-5 w-5', dark ? 'text-orange' : 'text-pink']}
          />
        )}
        <div class="flex items-baseline gap-3">
          <span class="font-display text-sm font-bold grad-text">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="font-display text-xl font-bold">{step.name}</h3>
        </div>
        <p class:list={['mt-3 text-sm', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
          {step.summary}
        </p>
        {!compact && (
          <p
            class:list={[
              'mt-4 text-xs leading-relaxed',
              dark ? 'text-ondark-muted/70' : 'text-ink-muted/80',
            ]}
          >
            {step.methods.join(' · ')}
          </p>
        )}
      </li>
    ))
  }
</Grid>
