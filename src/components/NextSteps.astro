---
/*
  Brief §70: internal links are framed as "Where might you go next?", based on
  what the visitor might sensibly need next. Never "You may also be interested in…".

  These are links, so they are Panels — bordered, rounded, and they lift on
  hover. The Grid treatment is reserved for things that don't go anywhere.
*/
import type { NavLink } from '@/data/site';

interface Props {
  links: NavLink[];
  title?: string;
  tone?: 'dark' | 'light';
}
const { links, title = 'Where might you go next?', tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<div>
  <h2 class="text-title">{title}</h2>
  <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'group relative isolate flex h-full flex-col overflow-hidden rounded-card border p-6 transition duration-200 hover:-translate-y-1',
              dark
                ? 'border-navy-700 bg-navy-800 hover:border-orange/60 hover:shadow-xl hover:shadow-black/30'
                : 'border-line bg-paper hover:border-transparent hover:shadow-xl hover:shadow-navy-900/10',
            ]}
          >
            <span
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 grad-rule transition-transform duration-300 group-hover:scale-x-100"
            />
            <span class="font-display text-base font-semibold">{l.label}</span>
            {l.blurb && (
              <span class:list={['mt-2 text-sm', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
                {l.blurb}
              </span>
            )}
            <span class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold grad-text">
              <svg
                class="h-4 w-4 text-pink transition-transform duration-200 group-hover:translate-x-1.5"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                aria-hidden="true"
              >
                <path d="M2 7h10M8 3l4 4-4 4" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
