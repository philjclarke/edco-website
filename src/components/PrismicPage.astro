---
/*
  The one template for product, capability and outcome pages, built from
  Prismic. Below the hero, the page is the editor's own arrangement of
  sections (see Slices.astro), then social proof if switched on, then
  "You might also be interested in".
*/
import Layout from '@/layouts/Layout.astro';
import PageHero from './PageHero.astro';
import Slices from './Slices.astro';
import Section from './Section.astro';
import Testimonial from './Testimonial.astro';
import LogoWall from './LogoWall.astro';
import NextSteps from './NextSteps.astro';
import CtaBand from './CtaBand.astro';
import type { SectionPage } from '@/data/sectionPages';
import { sectionPageByHref } from '@/data/outcomes';
import { hrefOf, textOf } from '@/lib/prismic';

interface Props {
  page: SectionPage;
  /** The section this page belongs to, for the breadcrumb. */
  section: { label: string; href: string };
  /** Set when rendering draft content for a Prismic preview. */
  preview?: { repositoryName: string; exitHref: string };
}
const { page, section, preview } = Astro.props;
const d = page.doc.data as Record<string, any>;

// Related links take their label and description from the page they point
// to, unless the editor wrote their own.
const byHref = await sectionPageByHref();
type Link = { href: string; label: string; blurb?: string };
const related: Link[] = (d.related ?? [])
  .map((r: any): Link | null => {
    const href = hrefOf(r.link);
    if (!href) return null;
    const target = byHref.get(href);
    return {
      href,
      label: textOf(r.label) || target?.navLabel || 'Find out more',
      blurb: textOf(r.blurb) || target?.summary || undefined,
    };
  })
  .filter((l: Link | null): l is Link => l !== null);
---

<Layout title={page.metaTitle ?? page.navLabel} description={page.metaDescription ?? page.summary}>
  {
    preview && (
      <Fragment slot="head">
        <meta name="robots" content="noindex, nofollow" />
        {/* Prismic's toolbar: shows the preview, and reloads when a draft is saved. */}
        <script is:inline async defer src={`https://static.cdn.prismic.io/prismic.js?new=true&repo=${preview.repositoryName}`} />
      </Fragment>
    )
  }
  {
    preview && (
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 bg-orange px-4 py-2 text-center text-[13px] font-semibold text-navy-900">
        <span>Preview: draft content from Prismic, not the live site</span>
        <a href={preview.exitHref} class="underline">Exit preview</a>
      </div>
    )
  }
  <PageHero
    parent={section}
    eyebrow={page.navLabel}
    title={page.title}
    standfirst={page.standfirst}
    lead={page.lead}
    externalSite={page.externalSite}
    banner={page.banner}
    size={page.kind === 'outcome' ? 'lg' : undefined}
  />

  <Slices slices={d.slices ?? []} />

  {
    d.show_social_proof !== false && (
      <Section tone="mist" size="md">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-center">
          <div>
            <p class="eyebrow grad-text mb-4">Social proof</p>
            <h2 class="text-title">Don’t take our word for it.</h2>
          </div>
          <Testimonial prompt={textOf(d.testimonial_theme) || 'working with EdCo'} />
        </div>
        <div class="mt-12">
          <LogoWall />
        </div>
      </Section>
    )
  }

  {
    related.length > 0 && (
      <Section tone="light" size="md">
        <NextSteps title="You might also be interested in" links={related} icons />
      </Section>
    )
  }

  <CtaBand />
</Layout>
