---
/*
  The full-width band between template sections. With no copy yet it shows a
  mock quote while MOCK_PROOF is on (see src/data/mock.ts), and a placeholder
  otherwise — either way the gap is visible rather than silently closed.
*/
import { pagePath } from '@/lib/content';
import Placeholder from './Placeholder.astro';
import { MOCK_PROOF, mockShout } from '@/data/mock';

interface Props {
  /** A small label above the quote. */
  header?: string;
  text?: string;
  /** Who said it, in bold. With a name the text is a quote, and the footer is their role. */
  name?: string;
  sub?: string;
  /** Its position on the page, for the placeholder. */
  n: number;
  /** Navy by default; white or grey for a lighter pull quote. */
  tone?: 'dark' | 'light' | 'mist';
}
const { header, text, name, sub, n, tone = 'dark' } = Astro.props;
const dark = tone === 'dark';
const muted = dark ? 'text-ondark-muted' : 'text-ink-muted';
const strong = dark ? 'text-ondark' : 'text-ink';
const quoted = (t: string) => (/^[“"]/.test(t) ? t : `“${t.replace(/[”"]$/, '')}”`);
const filled = !!text?.trim();
const mock = !filled && MOCK_PROOF ? mockShout(pagePath(Astro.locals, Astro.url), n) : null;
---

<section
  class:list={[
    { dark: 'bg-navy-900 text-ondark', light: 'bg-paper text-ink', mist: 'bg-mist text-ink' }[tone],
    filled || mock ? 'py-14 md:py-20' : 'py-6',
  ]}
  data-mock={mock ? 'shout-out' : undefined}
  data-pagefind-ignore={mock ? 'all' : undefined}
>
  <div class="mx-auto max-w-4xl px-6 text-center">
    {header?.trim() && (filled || mock) && <p class:list={['eyebrow mb-6', muted]}>{header}</p>}
    {
      filled && name?.trim() ? (
        <figure>
          <div class="mx-auto mb-8 h-1 w-16 rounded-full grad-rule" />
          <blockquote class="font-display text-display font-bold">{quoted(text!.trim())}</blockquote>
          <figcaption class:list={['mt-6 text-sm', muted]}>
            <span class:list={['font-semibold', strong]}>{name.trim()}</span>
            {sub?.trim() && <> · {sub.trim()}</>}
          </figcaption>
        </figure>
      ) : filled ? (
        <>
          <div class="mx-auto mb-8 h-1 w-16 rounded-full grad-rule" />
          <p class="font-display text-display font-bold">{text}</p>
          {sub?.trim() && <p class:list={['mt-6 text-intro', muted]}>{sub}</p>}
        </>
      ) : mock ? (
        <figure>
          <div class="mx-auto mb-8 h-1 w-16 rounded-full grad-rule" />
          <blockquote class="font-display text-display font-bold">“{mock.text}”</blockquote>
          <figcaption class:list={['mt-6 text-sm', muted]}>
            <span class:list={['font-semibold', strong]}>{mock.cite.name}</span> · {mock.cite.role},{' '}
            {mock.cite.org}
          </figcaption>
        </figure>
      ) : (
        <Placeholder label={`SHOUT OUT ${n}`} note="copy needed — a line that carries the argument" />
      )
    }
  </div>
</section>
