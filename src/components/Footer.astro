---
import { contact, site } from '@/data/site';
import { menu } from '@/lib/menu';

const footerNav = (await menu(Astro.locals)).footer;

// About subpages in Prismic; their UIDs give these addresses.
const legal = [
  { label: 'Privacy policy', href: '/about/privacy-policy/' },
  { label: 'Cookie policy', href: '/about/cookie-policy/' },
  { label: 'Terms', href: '/about/terms/' },
  { label: 'Slavery & human trafficking policy', href: '/about/slavery-human-trafficking-policy/' },
];
---

<footer class="bg-navy-950 text-ondark">
  <div class="h-1 grad-rule"></div>

  <!-- Brief §52: not "our newsletter". -->
  <div class="border-b border-navy-800">
    <div class="mx-auto grid max-w-7xl gap-8 px-6 py-14 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="text-title">Keep listening with us.</h2>
        <p class="mt-4 max-w-xl text-ondark-muted">
          Get the most useful things we’re hearing from educators, new research, EdCo opinion and
          invitations to events. No generic education-news roundup. Just things we think are worth
          knowing.
        </p>
        <p class="mt-3 font-display text-sm font-semibold grad-text">
          Worth knowing. Occasionally worth debating.
        </p>
      </div>
      <form
        method="post"
        action="/api/form"
        class="relative flex flex-col gap-3 sm:flex-row sm:items-end"
        data-form="subscribe"
        data-sent="Thank you. We’ll add you to the list."
        data-error={`Sorry, that didn’t send. Please try again, or ring us on ${contact.phone}.`}
      >
        <input type="hidden" name="form" value="subscribe" />
        <div class="absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true">
          <label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="flex min-w-0 flex-1 flex-col gap-1.5">
          <label class="pl-5 text-xs font-medium text-ondark-muted" for="sub-name">Name</label>
          <input
            id="sub-name"
            name="name"
            autocomplete="name"
            class="min-w-0 rounded-full border border-field-ondark bg-navy-900 px-5 py-3 text-sm"
          />
        </div>
        <div class="flex min-w-0 flex-1 flex-col gap-1.5">
          <label class="pl-5 text-xs font-medium text-ondark-muted" for="sub-email">Work email</label>
          <input
            id="sub-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="min-w-0 rounded-full border border-field-ondark bg-navy-900 px-5 py-3 text-sm"
          />
        </div>
        <button
          type="submit"
          class="shrink-0 rounded-full bg-[linear-gradient(96deg,var(--color-orange),var(--color-pink))] px-6 py-3 font-display text-sm font-semibold text-white transition hover:brightness-110"
          >Keep listening</button
        >
        <p data-form-status role="status" tabindex="-1" hidden class="self-center text-sm text-ondark-muted outline-none data-[state=sent]:font-display data-[state=sent]:text-base data-[state=sent]:font-semibold data-[state=sent]:text-ondark sm:basis-full"></p>
      </form>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-14">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,3fr)]">
      <div>
        {/* Pre-built rather than astro:assets — see the note in Header.astro. */}
        <img
          src="/brand/edco-logo-reversed.svg"
          width="216"
          height="82"
          alt={site.name}
          class="h-12 w-auto"
          loading="lazy"
        />
        <address class="mt-6 text-sm not-italic text-ondark-muted">
          {contact.address.map((line) => <span class="block">{line}</span>)}
          <a href={contact.phoneHref} class="mt-3 block hover:text-orange">{contact.phone}</a>
        </address>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          footerNav.map((group) => (
            <div>
              <h2 class="font-display text-sm font-semibold">{group.heading}</h2>
              <ul class="mt-4 space-y-2.5">
                {group.links.map((l) => (
                  <li>
                    <a href={l.href} class="text-sm text-ondark-muted transition-colors hover:text-orange">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-navy-800">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-6 text-xs text-ondark-muted"
    >
      <div class="space-y-1">
        <p>© {new Date().getFullYear()} The Education Company. Registered in England.</p>
        <p>
          <span class="whitespace-nowrap">Company registration number: 02651241</span> ·
          <span class="whitespace-nowrap">VAT registration number: GB 573 7684 93</span>
        </p>
      </div>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          legal.map((l) => (
            <li>
              <a href={l.href} class="transition-colors hover:text-orange">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<script>
  import '@/scripts/forms';
</script>
