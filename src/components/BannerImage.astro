---
/*
  Photography for a hero banner, treated in CSS so no image ever needs opening
  in Photoshop and nothing has to line up by hand.

  Two edge treatments:
    fade   — the photo dissolves into the section ground on its left edge.
             Nothing to align, works with any crop. The default.
    shape  — the photo is clipped into a curve echoing the brand ribbon.
             The curve is in objectBoundingBox units so it scales with the
             container rather than being a fixed asset.

  `duotone` blends the brand gradient through by luminosity, which pulls any
  stock photograph onto the palette.

  On a phone the photo would be a sliver beside the copy, so it gives way to
  a gradient in the brand blues. The photo isn't downloaded there either: the
  <picture> hands a phone a blank pixel instead. No orange in the gradient,
  so the white and grey copy keeps its contrast.
*/
import { getImage } from 'astro:assets';
import { banners, isBannerKey } from '@/data/banners';
import { srcsetOf, type RemoteImage } from '@/lib/prismic';

interface Props {
  /** A key from src/data/banners.ts, or an image from Prismic. */
  src: string | RemoteImage;
  alt?: string;
  treatment?: 'fade' | 'shape';
  duotone?: boolean;
  /** Which part of the photo to keep when it crops. */
  focus?: 'left' | 'centre' | 'right';
  class?: string;
}
const {
  src,
  alt = '',
  treatment = 'fade',
  duotone = false,
  focus = 'centre',
  class: cls = '',
} = Astro.props;

// Fail the build rather than render an empty banner — an unregistered image
// is silent otherwise, and a hero quietly missing its photograph is easy to ship.
const remote = typeof src === 'object' ? srcsetOf(src, [700, 1100, 1600]) : null;
if (typeof src === 'string' && !isBannerKey(src)) {
  throw new Error(
    `BannerImage: unknown image "${src}". Register it in src/data/banners.ts. ` +
      `Known: ${Object.keys(banners).join(', ')}`
  );
}
const local =
  typeof src === 'string'
    ? await getImage({ src: banners[src as keyof typeof banners], widths: [700, 1100, 1600] })
    : null;
const img = remote ?? { src: local!.src, srcset: local!.srcSet.attribute };
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const objectPos = { left: 'object-left', centre: 'object-center', right: 'object-right' }[focus];
// Unique per instance: two shape banners on one page would otherwise both
// resolve to whichever clipPath the browser saw first.
const clipId = `banner-curve-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_70%_at_100%_0%,#24365f_0%,rgba(36,54,95,0)_70%),linear-gradient(165deg,var(--color-navy-900)_45%,#1a2645_100%)] md:hidden"
  aria-hidden="true"
>
</div>
<div
  class:list={['pointer-events-none absolute inset-y-0 right-0 hidden w-[56%] md:block', cls]}
  aria-hidden={alt ? undefined : 'true'}
>
  {
    treatment === 'shape' && (
      <svg width="0" height="0" class="absolute" aria-hidden="true">
        <defs>
          <clipPath id={clipId} clipPathUnits="objectBoundingBox">
            {/* An S-curve down the left edge, echoing the ribbon device. */}
            <path d="M0.30,0 C0.12,0.26 0.40,0.56 0.20,0.82 C0.12,0.93 0.14,0.97 0.16,1 L1,1 L1,0 Z" />
          </clipPath>
        </defs>
      </svg>
    )
  }

  <div
    class:list={[
      'relative h-full w-full',
      duotone && 'bg-[linear-gradient(150deg,var(--color-navy-900)_10%,var(--color-orange)_120%)]',
    ]}
    style={treatment === 'shape' ? `clip-path: url(#${clipId})` : undefined}
  >
    <picture class="block h-full w-full">
      <source media="(max-width: 767px)" srcset={BLANK} />
      <img
        src={img.src}
        srcset={img.srcset}
        alt={alt}
        sizes="56vw"
        class:list={[
          'h-full w-full object-cover',
          objectPos,
          duotone && 'opacity-90 mix-blend-luminosity grayscale contrast-[1.1]',
        ]}
        loading="eager"
        fetchpriority="high"
      />
    </picture>

    {/* The copy always has to win. Fade dissolves the whole left edge; shape
        only needs a short veil where the curve meets the text. */}
    <div
      class:list={[
        'absolute inset-0',
        treatment === 'fade'
          ? 'bg-[linear-gradient(90deg,var(--color-navy-900)_0%,rgba(15,20,33,0.88)_22%,rgba(15,20,33,0)_62%)]'
          : 'bg-[linear-gradient(90deg,rgba(15,20,33,0.55)_0%,rgba(15,20,33,0)_38%)]',
      ]}
    >
    </div>
  </div>
</div>
