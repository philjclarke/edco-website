---
/*
  A list of short items, shown as an icon grid: a glyph above each item, in the
  same Grid as the other non-clickable sets on the site.

  It was a ruled list with a tick against every line. Review found that flat —
  every item wore the same mark, so the mark said nothing. An icon per item
  gives the eye somewhere to land and says something about each one.

  Icons come in a parallel array, matched by position rather than by wording,
  so rewording an item in the copy deck keeps its icon. An item without one
  falls back to a tick.
*/
import { Icon } from 'astro-icon/components';
import Grid from './Grid.astro';

interface Props {
  items: readonly string[];
  icons?: readonly string[];
  columns?: 1 | 2 | 3;
  tone?: 'dark' | 'light';
}
const { items, icons = [], columns = 2, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
const cols = (columns === 1 ? 2 : columns) as 2 | 3;
---

<Grid cols={cols} tone={tone} as="ul">
  {
    items.map((item, i) => (
      <li class="p-5 md:p-6">
        <Icon
          name={icons[i] ?? 'fa6-solid:circle-check'}
          class:list={['mb-3 h-5 w-5', dark ? 'text-orange' : 'text-pink']}
        />
        <span class="block text-[0.9375rem] font-medium leading-snug">{item}</span>
      </li>
    ))
  }
</Grid>
