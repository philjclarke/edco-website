---
/*
  A list of short items, each with an icon matched by position (so rewording
  an item in the copy deck keeps its icon). An item without one gets a tick.

  Three treatments, compared on /prototype/patterns/:
    dense — icon in a tinted square beside the text, in ruled cells. The
            Features listing component, as the component deck shows it
            (Oct 2026).
    list  — a ruled list in columns, icon as the bullet. No cells at all.
            The default, chosen in the September review.
    grid  — an icon above each item in a roomy Grid. The old default; the
            items are rarely more than a few words, so it read as thin.
*/
import { Icon } from 'astro-icon/components';
import Grid from './Grid.astro';

export type TickListVariant = 'grid' | 'dense' | 'list';

interface Props {
  items: readonly string[];
  icons?: readonly (string | undefined)[];
  /** A line under each item, by position (the list treatment only). */
  explainers?: readonly (string | undefined)[];
  columns?: 1 | 2 | 3;
  tone?: 'dark' | 'light';
  variant?: TickListVariant;
  /** Sits in half the page's width (dense only): two columns at most. */
  half?: boolean;
}
const { items, icons = [], explainers = [], columns = 2, tone = 'light', variant = 'list', half = false } = Astro.props;
const dark = tone === 'dark';
const cols = (columns === 1 ? 2 : columns) as 2 | 3;
const iconOf = (i: number) => icons[i] || 'fa6-solid:circle-check';
const accent = dark ? 'text-orange' : 'text-pink';

// Dense and list choose their own columns from the item count: three for a
// short list, four (dense) or three (list) once it's long.
const denseCols = (half ? 2 : items.length <= 6 ? 3 : 4) as 2 | 3 | 4;
const listCols = items.length <= 6 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---

{
  variant === 'grid' && (
    <Grid cols={cols} tone={tone} as="ul">
      {items.map((item, i) => (
        <li class="p-5 md:p-6">
          <Icon name={iconOf(i)} class:list={['mb-3 h-5 w-5', accent]} />
          <span class="block text-[0.9375rem] font-medium leading-snug">{item}</span>
        </li>
      ))}
    </Grid>
  )
}

{
  variant === 'dense' && (
    <Grid cols={denseCols} tone={tone} as="ul">
      {items.map((item, i) => (
        <li class:list={['flex gap-4 px-5 py-4', explainers[i] ? 'items-start' : 'items-center']}>
          <span
            class:list={[
              'inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg',
              dark ? 'bg-navy-700 text-orange' : 'bg-pink/10 text-pink',
            ]}
          >
            <Icon name={iconOf(i)} class="h-4 w-4" />
          </span>
          <span>
            <span class="block text-[0.9375rem] font-medium leading-snug">{item}</span>
            {explainers[i] && (
              <span class:list={['mt-1 block text-sm', dark ? 'text-ondark-muted' : 'text-ink-muted']}>{explainers[i]}</span>
            )}
          </span>
        </li>
      ))}
    </Grid>
  )
}

{
  variant === 'list' && (
    <ul class:list={['grid content-start gap-x-10', listCols]}>
      {items.map((item, i) => (
        <li
          class:list={[
            'flex items-start gap-3 border-b py-3',
            dark ? 'border-navy-700' : 'border-line',
          ]}
        >
          <Icon name={iconOf(i)} class:list={['mt-0.5 h-4 w-4 shrink-0', accent]} />
          {explainers[i] ? (
            <span>
              <span class="block text-[0.9375rem] font-medium leading-snug">{item}</span>
              <span class:list={['mt-1 block text-sm', dark ? 'text-ondark-muted' : 'text-ink-muted']}>{explainers[i]}</span>
            </span>
          ) : (
            <span class="text-[0.9375rem] leading-snug">{item}</span>
          )}
        </li>
      ))}
    </ul>
  )
}
