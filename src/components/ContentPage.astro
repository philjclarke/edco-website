---
/* Shared page for products and capabilities (brief §27–§43). Below the hero,
   the layout is the section template's. */
import Layout from '@/layouts/Layout.astro';
import PageHero from './PageHero.astro';
import SectionTemplate from './SectionTemplate.astro';
import CtaBand from './CtaBand.astro';
import type { ContentPage } from '@/data/blocks';

interface Props {
  page: ContentPage;
  /** The section this page belongs to, for the breadcrumb. */
  section: { label: string; href: string };
  kind: 'product' | 'capability';
}
const { page, section, kind } = Astro.props;
---

<Layout title={page.navLabel} description={page.summary}>
  <PageHero
    parent={section}
    eyebrow={page.navLabel}
    title={page.title}
    standfirst={page.standfirst}
    lead={page.lead}
    externalSite={page.externalSite}
    banner={page.banner}
  />

  <SectionTemplate
    kind={kind}
    blocks={page.blocks}
    testimonialTheme={page.testimonialTheme}
    related={page.next.filter((l) => l.href !== '/contact/')}
  />

  <CtaBand />
</Layout>
