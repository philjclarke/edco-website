---
import { primaryNav, utilityNav, site, contact } from '@/data/site';
import Button from './Button.astro';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
const dark = tone === 'dark';
const path = Astro.url.pathname;
---

<!--
  On desktop the header stays on screen. Once the page scrolls, it pins to the
  top in a compact form: utility bar tucked away, logo smaller. The wrapper
  keeps the full header's height, so the page doesn't jump when it compacts.
  Mobile is unchanged — the menu button is always at the top anyway.
-->
<div
  id="site-header"
  class:list={['relative z-40 lg:h-(--header-h)', dark ? 'bg-navy-900' : 'bg-paper']}
>
<header
  class:list={[
    'group/header relative z-40 inset-x-0 top-0 transition-shadow lg:data-stuck:fixed lg:data-stuck:shadow-xl',
    dark ? 'bg-navy-900 text-ondark lg:data-stuck:shadow-black/30' : 'bg-paper text-ink border-b border-line lg:data-stuck:shadow-navy-900/10',
  ]}
>
  <!-- Utility bar -->
  <div
    class:list={[
      'hidden lg:block lg:group-data-stuck/header:hidden',
      dark ? 'border-b border-navy-700' : 'border-b border-line',
    ]}
  >
    <div class="mx-auto flex max-w-7xl items-center justify-end gap-6 px-6 py-2 text-xs">
      {
        utilityNav.map((l) => (
          <a
            href={l.href}
            class:list={[
              'transition-colors hover:text-orange',
              dark ? 'text-ondark-muted' : 'text-ink-muted',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={contact.phoneHref}
        class:list={['transition-colors hover:text-orange', dark ? 'text-ondark-muted' : 'text-ink-muted']}
        >{contact.phone}</a
      >
    </div>
  </div>

  <div class="mx-auto flex max-w-7xl items-center justify-between gap-8 px-6 py-3 lg:group-data-stuck/header:py-2">
    <a href="/" class="shrink-0" aria-label="The Education Company — home">
      {/*
        A plain <img> against pre-built files rather than astro:assets. On a
        server-rendered page astro:assets emits /_image?… , which needs a
        runtime image endpoint this deployment doesn't have — so the logo broke
        on /admin while every static page was fine. The logo is one fixed asset
        at one size on every page, so pre-generating it is simpler than adding
        an image service, and keeps the header identical everywhere.
      */}
      <img
        src={`/brand/edco-logo-${dark ? 'reversed' : 'positive'}-200.webp`}
        srcset={`/brand/edco-logo-${dark ? 'reversed' : 'positive'}-200.webp 200w, /brand/edco-logo-${dark ? 'reversed' : 'positive'}-400.webp 400w`}
        sizes="200px"
        width="200"
        height="82"
        alt="The Education Company"
        class="h-16 w-auto transition-[height] duration-200 md:h-[4.5rem] lg:h-20 lg:group-data-stuck/header:h-12"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center lg:flex" aria-label="Primary">
      {
        primaryNav.map((item) => {
          const active = path.startsWith(item.href) && item.href !== '/';
          return item.children ? (
            <div class="group relative">
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-1 whitespace-nowrap rounded-lg px-2.5 py-2 text-[0.8125rem] font-medium transition-colors',
                  dark ? 'hover:bg-navy-800' : 'hover:bg-mist',
                  active && 'text-orange',
                ]}
              >
                {item.label}
                <svg class="h-3 w-3 opacity-60" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                </svg>
              </a>
              <div class="invisible absolute left-0 top-full w-72 pt-2 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <ul class="overflow-hidden rounded-card border border-navy-700 bg-navy-800 py-2 text-ondark shadow-2xl">
                  {item.children.map((c) => (
                    <li>
                      <a
                        href={c.href}
                        class="block px-4 py-2.5 text-sm transition-colors hover:bg-navy-700 hover:text-orange"
                      >
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'whitespace-nowrap rounded-lg px-2.5 py-2 text-[0.8125rem] font-medium transition-colors',
                dark ? 'hover:bg-navy-800' : 'hover:bg-mist',
                active && 'text-orange',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden shrink-0 2xl:block">
      <Button href={site.primaryCta.href} size="sm">Tell us what you’re trying to achieve</Button>
    </div>

    <!-- Mobile toggle -->
    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class:list={[
        'rounded-lg border p-2 lg:hidden',
        dark ? 'border-navy-700' : 'border-line',
      ]}
    >
      <span class="sr-only">Menu</span>
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" hidden class:list={['lg:hidden', dark ? 'bg-navy-900' : 'bg-paper']}>
    <nav class="mx-auto max-w-7xl px-6 pb-8" aria-label="Primary (mobile)">
      <ul class:list={['divide-y', dark ? 'divide-navy-700' : 'divide-line']}>
        {
          primaryNav.map((item) => (
            <li class="py-3">
              <a href={item.href} class="block font-display text-base font-semibold">
                {item.label}
              </a>
              {item.children && (
                <ul class="mt-2 space-y-1 pl-3">
                  {item.children.map((c) => (
                    <li>
                      <a
                        href={c.href}
                        class:list={[
                          'block py-1.5 text-sm',
                          dark ? 'text-ondark-muted' : 'text-ink-muted',
                        ]}
                      >
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        {
          utilityNav.map((l) => (
            <li class="py-3">
              <a href={l.href} class="block text-sm font-medium">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6">
        <Button href={site.primaryCta.href} full>Tell us what you’re trying to achieve</Button>
      </div>
    </nav>
  </div>
</header>
</div>

<script>
  // Desktop: pin a compact header once the utility bar has scrolled away.
  const wrap = document.getElementById('site-header');
  const bar = wrap?.querySelector('header');
  const utility = bar?.firstElementChild as HTMLElement | null;
  const desktop = matchMedia('(min-width: 64rem)');
  if (wrap && bar) {
    // The full header is one height at every desktop width, so measure it
    // only while it is full — never mid-way through compacting.
    const measure = () => {
      if (!bar.hasAttribute('data-stuck')) wrap.style.setProperty('--header-h', `${bar.offsetHeight}px`);
      update();
    };
    const update = () => {
      // Once the utility bar has scrolled out of view.
      const stuck = desktop.matches && scrollY > (utility?.offsetHeight ?? 0);
      bar.toggleAttribute('data-stuck', stuck);
    };
    measure();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', measure);
    desktop.addEventListener('change', measure);
  }

  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>
