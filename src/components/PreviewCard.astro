---
/*
  A card for any page, filled from its Preview tab: content listings use it.
  Insights and opinion show their date and author; other pages show their
  positioning statement and a link label. A preview image fades in on the
  right (component deck, slide 8).
*/
import type { PagePreview } from '@/lib/pages';
import FadedPhoto from './FadedPhoto.astro';
import Logo from './Logo.astro';

interface Props {
  page: PagePreview;
  tone?: 'dark' | 'light';
  /** 2 when the listing has no heading of its own, so no level is skipped. */
  level?: 2 | 3;
}
const { page, tone = 'light', level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const dark = tone === 'dark';
const a = page.article;
---

<a
  href={page.href}
  class:list={[
    'group relative isolate flex h-full flex-col overflow-hidden rounded-card border p-6 transition md:p-7',
    dark
      ? 'border-navy-700 bg-navy-800 hover:border-orange/60'
      : 'border-line bg-paper hover:border-ink/25 hover:shadow-lg hover:shadow-navy-900/5',
  ]}
>
  {page.image && <FadedPhoto image={page.image} placement="card" />}
  {page.logo && <Logo pair={page.logo} onDark={dark} name={page.title} class="mb-5 h-12 w-auto max-w-[13rem] object-left" />}
  {a && <p class:list={['eyebrow mb-3', dark ? 'text-ondark-muted' : 'text-ink-muted']}>{a.label}</p>}
  <Heading class="text-subtitle">{page.title}</Heading>
  {!a && page.positioning && <p class="mt-2 font-display text-base font-semibold leading-snug grad-text">{page.positioning}</p>}
  {page.text && <p class:list={['mt-3 text-sm', dark ? 'text-ondark-muted' : 'text-ink-muted']}>{page.text}</p>}
  {
    a ? (
      <p class:list={['mt-auto flex flex-wrap items-center gap-x-3 pt-5 text-xs', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
        {a.date && <time datetime={a.date.toISOString()}>{a.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>}
        {a.author && <span>{a.author}</span>}
      </p>
    ) : (
      <span class="mt-auto pt-5 text-sm font-medium grad-text">{page.linkLabel ?? 'Find out more'} →</span>
    )
  }
</a>
