---
import type { Block } from '@/data/blocks';
import { Icon } from 'astro-icon/components';
import TickList from './TickList.astro';
import ProductShot from './ProductShot.astro';
import Grid from './Grid.astro';
import ProcessGrid from './ProcessGrid.astro';
import Placeholder from './Placeholder.astro';
import FadedPhoto from './FadedPhoto.astro';
import Button from './Button.astro';

interface Props {
  blocks: Block[];
  /** One background for all of them, when they fill one template slot. */
  tone?: 'paper' | 'mist';
}
const { blocks, tone } = Astro.props;

// Left to themselves, blocks alternate white / mist so a long page keeps a
// rhythm. Sharing a slot, they share a background and read as one section.
const bg = (i: number) =>
  tone ? { paper: 'bg-paper', mist: 'bg-mist' }[tone] : i % 2 === 1 ? 'bg-mist' : 'bg-paper';
// A block given a navy background of its own.
const isDark = (b: Block) => 'tone' in b && b.tone === 'dark';
const muted = (b: Block) => (isDark(b) ? 'text-ondark-muted' : 'text-ink-muted');
---

{
  blocks.map((block, i) => (
    <section
      class:list={[
        'py-14 md:py-20',
        block.type === 'pull' || isDark(block)
          ? 'bg-navy-900 text-ondark'
          : 'tone' in block && block.tone === 'mist'
            ? 'bg-mist'
            : bg(i),
        tone && i > 0 && 'pt-0 md:pt-0',
        block.type === 'shots' && block.photo && 'relative isolate overflow-hidden',
      ]}
    >
      {block.type === 'shots' && block.photo && <FadedPhoto image={block.photo} />}
      <div class="mx-auto max-w-7xl px-6">
        {block.type === 'prose' && (
          <div
            class:list={[
              block.layout === 'beside'
                ? 'grid gap-6 lg:grid-cols-3 lg:gap-16'
                : block.layout === 'wide'
                  ? 'max-w-5xl'
                  : 'max-w-3xl',
            ]}
          >
            {block.title && <h2 class:list={['text-title', block.layout !== 'beside' && 'mb-6']}>{block.title}</h2>}
            {block.html ? (
              <div
                class:list={[
                  'prose-edco',
                  muted(block),
                  block.size !== 'standard' && 'text-intro',
                  block.layout === 'wide' && 'max-w-none',
                  block.layout === 'beside' && 'lg:col-span-2 lg:col-start-2',
                ]}
                set:html={block.html}
              />
            ) : (
              <div class:list={['prose-edco text-intro', muted(block)]}>
                {block.paras.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            )}
          </div>
        )}

        {block.type === 'list' && (
          <div class:list={[block.layout === 'beside' && 'grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-20']}>
            <div class="max-w-3xl">
              {block.eyebrow && <p class="eyebrow grad-text mb-4">{block.eyebrow}</p>}
              {block.title && <h2 class="text-title">{block.title}</h2>}
              {block.lead && <p class:list={['mt-4 text-intro', muted(block)]}>{block.lead}</p>}
            </div>
            <div class:list={[(block.title || block.lead) && block.layout !== 'beside' && 'mt-8']}>
              <TickList
                items={block.items}
                icons={block.icons}
                explainers={block.explainers}
                columns={block.columns ?? 2}
                variant="dense"
                half={block.layout === 'beside'}
                tone={block.tone === 'dark' ? 'dark' : 'light'}
              />
            </div>
          </div>
        )}

        {block.type === 'steps' && (
          <div>
            <div class="max-w-3xl">
              {block.title && <h2 class="text-title">{block.title}</h2>}
              {block.lead && <p class:list={['mt-4 text-intro', muted(block)]}>{block.lead}</p>}
            </div>
            <div class="mt-8">
              <ProcessGrid steps={block.steps} tone={block.tone === 'dark' ? 'dark' : 'light'} />
            </div>
            {block.after && <p class:list={['mt-8 max-w-3xl text-intro', muted(block)]}>{block.after}</p>}
            {block.button && (
              <div class="mt-10">
                <Button href={block.button.href} size="lg">{block.button.label}</Button>
              </div>
            )}
          </div>
        )}

        {block.type === 'ways' && (
          <div>
            {block.title && (
              <div class="max-w-3xl">
                <h2 class="text-title">{block.title}</h2>
                {block.lead && <p class:list={['mt-4 text-intro', muted(block)]}>{block.lead}</p>}
              </div>
            )}
            <Grid cols={3} class="mt-10" as="ol" tone={isDark(block) ? 'dark' : 'light'}>
              {block.items.map((w, i) => (
                <li class="flex h-full flex-col p-6">
                  {w.icon ? (
                    <Icon name={w.icon} class="mb-4 h-5 w-5 text-pink" />
                  ) : (
                    <span class="mb-4 font-display text-sm font-bold grad-text">{String(i + 1).padStart(2, '0')}</span>
                  )}
                  <h3 class="text-subtitle">{w.title}</h3>
                  <p class:list={['mt-3 text-sm', muted(block)]}>{w.body}</p>
                  <ul class="mt-auto space-y-1.5 pt-4">
                    {w.points.map((pt) => (
                      <li class="flex items-start gap-2 text-sm">
                        <svg
                          class="mt-1.5 h-3 w-3 shrink-0 text-pink"
                          viewBox="0 0 12 12"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path d="M2 6.5 4.8 9.2 10 3.2" />
                        </svg>
                        <span>{pt}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </Grid>
          </div>
        )}

        {block.type === 'shots' && (
          <div>
            {block.title && (
              <div class="max-w-3xl">
                {block.eyebrow && <p class="eyebrow grad-text mb-4">{block.eyebrow}</p>}
                <h2 class="text-title">{block.title}</h2>
                {block.lead && <p class="mt-4 text-intro text-ink-muted">{block.lead}</p>}
              </div>
            )}
            <div
              class:list={[
                'mt-8 grid gap-6',
                block.shots.length > 1 ? 'md:grid-cols-2' : 'max-w-3xl',
              ]}
            >
              {block.shots.map((sh) => (
                <ProductShot caption={sh.caption} src={sh.src} />
              ))}
            </div>
          </div>
        )}

        {block.type === 'pull' && (
          <div class="mx-auto max-w-4xl text-center">
            <div class="mx-auto mb-8 h-1 w-16 rounded-full grad-rule" />
            <p class="font-display text-display font-bold">{block.text}</p>
            {block.sub && <p class="mt-6 text-intro text-ondark-muted">{block.sub}</p>}
          </div>
        )}

        {block.type === 'cards' && (
          <div>
            {block.title && (
              <div class="max-w-3xl">
                <h2 class="text-title">{block.title}</h2>
                {block.lead && <p class:list={['mt-4 text-intro', muted(block)]}>{block.lead}</p>}
              </div>
            )}
            <div class:list={['mt-8', block.items.some((i) => i.detail || i.shot) ? 'grid gap-5 md:grid-cols-2 lg:grid-cols-3' : '']}>
              {!block.items.some((i) => i.detail || i.shot) ? (
                <Grid cols={3} tone={isDark(block) ? 'dark' : 'light'}>
                  {block.items.map((c) => (
                    <div class="p-6">
                      {c.icon && <Icon name={c.icon} class="mb-4 h-5 w-5 text-pink" />}
                      <h3 class="text-subtitle">{c.title}</h3>
                      <p class:list={['mt-3 text-sm', muted(block)]}>{c.body}</p>
                    </div>
                  ))}
                </Grid>
              ) : null}
              {block.items.map((c) =>
                block.items.some((i) => i.detail || i.shot) ? (
                  /* <details> keeps this keyboard-accessible and working with
                     no JavaScript — no pop-up library needed. */
                  <details
                    class:list={[
                      'group rounded-card border transition open:border-pink/50',
                      isDark(block) ? 'border-navy-700 bg-navy-800 hover:border-ondark/25' : 'border-line bg-paper hover:border-ink/25',
                    ]}
                  >
                    <summary class="flex cursor-pointer list-none items-start gap-3 p-6 [&::-webkit-details-marker]:hidden">
                      <span class="flex-1">
                        {c.icon && <Icon name={c.icon} class="mb-4 block h-5 w-5 text-pink" />}
                        <span class="block font-display text-subtitle font-bold">{c.title}</span>
                        <span class:list={['mt-3 block text-sm', muted(block)]}>{c.body}</span>
                      </span>
                      <svg
                        class="mt-1 h-4 w-4 shrink-0 text-pink transition-transform group-open:rotate-45"
                        viewBox="0 0 14 14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path d="M7 2v10M2 7h10" />
                      </svg>
                    </summary>
                    <div class:list={['border-t px-6 py-5', isDark(block) ? 'border-navy-700' : 'border-line']}>
                      {c.detail ? (
                        <p class:list={['text-sm', muted(block)]}>{c.detail}</p>
                      ) : (
                        <Placeholder label="DETAIL COPY" note={c.title} block />
                      )}
                      <div class="mt-4">
                        <ProductShot caption={c.title} src={c.shot} ratio="tall" />
                      </div>
                    </div>
                  </details>
                ) : null
              )}
            </div>
          </div>
        )}
      </div>
    </section>
  ))
}
