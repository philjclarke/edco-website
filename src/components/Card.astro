---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  /** Icon name. Renders in a gradient disc above the title. */
  icon?: string;
  eyebrow?: string;
  /** Empty when the card is a content placeholder. */
  title: string;
  body?: string;
  meta?: string;
  tone?: 'dark' | 'light';
  /** A numeral, shown only when there is no icon. */
  index?: number;
}
const { href, icon, eyebrow, title, body, meta, tone = 'light', index } = Astro.props;
const dark = tone === 'dark';
const Tag = href ? 'a' : 'div';
const linked = Boolean(href);
---

<Tag
  href={href}
  class:list={[
    'group relative isolate flex h-full flex-col overflow-hidden rounded-card border p-6 transition duration-200 md:p-7',
    dark ? 'border-navy-700 bg-navy-800' : 'border-line bg-paper',
    linked && 'hover:-translate-y-1',
    linked &&
      (dark
        ? 'hover:border-orange/60 hover:shadow-xl hover:shadow-black/30'
        : 'hover:border-transparent hover:shadow-xl hover:shadow-navy-900/10'),
  ]}
>
  {/* The ribbon gradient, revealed along the top edge on hover. */}
  {
    linked && (
      <span
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 grad-rule transition-transform duration-300 group-hover:scale-x-100"
      />
    )
  }
  {/* A soft wash from the corner, so the card warms rather than just lifts. */}
  {
    linked && (
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-16 -top-16 -z-10 h-40 w-40 rounded-full bg-[radial-gradient(circle,rgba(232,67,127,0.16),transparent_70%)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      />
    )
  }

  {
    icon && (
      <span
        class:list={[
          'mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-[linear-gradient(120deg,var(--color-orange),var(--color-pink))] text-white transition-transform duration-200',
          linked && 'group-hover:scale-105',
        ]}
      >
        <Icon name={icon} class="h-4 w-4" />
      </span>
    )
  }
  {
    index !== undefined && !icon && (
      <span
        class:list={[
          'mb-3 font-display text-3xl font-bold leading-none grad-text transition-transform duration-200 md:text-4xl',
          linked && 'group-hover:-translate-y-0.5',
        ]}
      >
        {String(index).padStart(2, '0')}
      </span>
    )
  }
  {eyebrow && <p class:list={['eyebrow mb-3', dark ? 'text-ondark-muted' : 'text-ink-muted']}>{eyebrow}</p>}
  {title && <h3 class="text-lg leading-snug md:text-xl">{title}</h3>}
  {body && <p class:list={['mt-3 text-sm', dark ? 'text-ondark-muted' : 'text-ink-muted']}>{body}</p>}
  <slot />
  {
    (meta || href) && (
      <p
        class:list={[
          'mt-auto flex items-center gap-2 pt-5 text-sm font-semibold',
          dark ? 'text-ondark' : 'text-ink',
        ]}
      >
        <span class="grad-text">{meta ?? 'Read more'}</span>
        {href && (
          <svg
            class="h-4 w-4 text-pink transition-transform duration-200 group-hover:translate-x-1.5"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            aria-hidden="true"
          >
            <path d="M2 7h10M8 3l4 4-4 4" />
          </svg>
        )}
      </p>
    )
  }
</Tag>
