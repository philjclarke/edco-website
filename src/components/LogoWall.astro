---
import Placeholder from './Placeholder.astro';
import { logoCandidates } from '@/data/proof';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<div>
  <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-card border sm:grid-cols-3 lg:grid-cols-5"
    class:list={[dark ? 'border-navy-700 bg-navy-700' : 'border-line bg-line']}>
    {
      logoCandidates.map((name) => (
        <li
          class:list={[
            'flex min-h-28 flex-col items-center justify-center gap-2 p-5 text-center',
            dark ? 'bg-navy-800' : 'bg-paper',
          ]}
        >
          <span class:list={['font-display text-sm font-semibold', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
            {name}
          </span>
          <Placeholder label="CLIENT LOGO" />
        </li>
      ))
    }
  </ul>
  <p class:list={['mt-4 text-xs', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
    Brief §76: relationships and logo permissions must be confirmed before launch. Nothing here
    implies a current relationship.
  </p>
</div>
