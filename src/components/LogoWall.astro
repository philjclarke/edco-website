---
/*
  Client logos — brief §17, §76. Not clickable, so a Grid.

  A logo wall can have its own logos, picked for that page (`items`). Without
  them it shows the clients from Site settings (Proof tab). Once any has a logo the
  wall shows them, in full colour on white tiles whatever the section's tone,
  since few brands allow their logo to be recoloured; a client still waiting
  for one shows its name and a placeholder. Until then, while MOCK_PROOF is
  on (src/data/mock.ts), the wall shows invented organisations so the design
  reads in full.

  Brief §76: nothing may imply a past relationship is current. Until every
  client on the wall is ticked as confirmed, a note under it says so. Logos
  picked for a wall are the editor's choice, so they carry no note.

  A last row that isn't full is completed with empty tiles, so the ruled
  lines run to the edge.
*/
import Placeholder from './Placeholder.astro';
import Logo from './Logo.astro';
import { MOCK_PROOF, mockLogos } from '@/data/mock';
import { siteSettings, type ClientLogo } from '@/lib/content';

interface Props {
  tone?: 'dark' | 'light';
  /** Logos picked for this wall, in place of Site settings' list. */
  items?: ClientLogo[];
}
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';

const picked = (Astro.props.items ?? []).filter((c) => c.logo);
const clients = picked.length ? picked : (await siteSettings(Astro.locals)).clientLogos.filter((c) => c.name || c.logo);
const real = clients.some((c) => c.logo);
const mock = !real && MOCK_PROOF;
const unconfirmed = !picked.length && clients.some((c) => !c.confirmed);

// Across a desktop: as many as there are, up to five; past five, whichever of
// five, four or three leaves the fewest gaps. Any gaps left in the last row
// are filled with empty tiles.
const count = mock ? mockLogos.length : clients.length;
const gaps = (n: number) => (n - (count % n)) % n;
const lgCols = count <= 5 ? Math.max(count, 2) : [5, 4, 3].reduce((a, n) => (gaps(n) < gaps(a) ? n : a));
const lgClass = { 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5' }[lgCols];
const [baseFill, smFill, lgFill] = [2, 3, lgCols].map(gaps);
const fillers = Array.from({ length: Math.max(baseFill, smFill, lgFill) }, (_, i) => [
  i < baseFill ? 'block' : 'hidden',
  i < smFill ? 'sm:block' : 'sm:hidden',
  i < lgFill ? 'lg:block' : 'lg:hidden',
]);
const tileBg = real ? 'bg-paper' : dark ? 'bg-navy-800' : 'bg-paper';

const typeClass = {
  bold: 'font-display font-bold tracking-tight',
  caps: 'font-display text-[0.6875rem] font-semibold uppercase tracking-[0.18em]',
  serif: 'font-serif italic',
  light: 'font-sans font-light tracking-wide',
};
---

<div data-mock={mock ? 'logos' : undefined} data-pagefind-ignore={mock ? 'all' : undefined}>
  <ul class:list={['grid grid-cols-2 gap-px overflow-hidden rounded-card border sm:grid-cols-3', lgClass, dark ? 'border-navy-700 bg-navy-700' : 'border-line bg-line']}>
    {
      mock
        ? mockLogos.map((l) => (
            <li
              class:list={[
                'flex min-h-28 items-center justify-center gap-2.5 p-5',
                dark ? 'bg-navy-800 text-ondark-muted' : 'bg-paper text-ink-muted',
              ]}
            >
              <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
                <path d={l.mark} />
              </svg>
              <span class:list={['max-w-[9rem] text-sm leading-tight', typeClass[l.type]]}>{l.name}</span>
            </li>
          ))
        : clients.map((c) => (
            <li
              class:list={[
                'flex min-h-28 flex-col items-center justify-center gap-2 p-5 text-center',
                real ? 'bg-paper' : dark ? 'bg-navy-800' : 'bg-paper',
              ]}
            >
              {c.logo ? (
                <Logo image={c.logo} name={c.name} class="h-14 w-full max-w-[9.5rem]" />
              ) : (
                <>
                  <span class:list={['font-display text-sm font-semibold', dark && !real ? 'text-ondark-muted' : 'text-ink-muted']}>
                    {c.name}
                  </span>
                  <Placeholder label="CLIENT LOGO" />
                </>
              )}
            </li>
          ))
    }
    {fillers.map((c) => <li class:list={[c, tileBg]} aria-hidden="true" />)}
  </ul>
  {
    (mock || unconfirmed) && (
      <p data-pagefind-ignore class:list={['mt-4 text-xs', dark ? 'text-ondark-muted' : 'text-ink-muted']}>
        {mock
          ? 'Sample logos — invented organisations, standing in until real logos and permissions are confirmed.'
          : 'Brief §76: relationships and logo permissions must be confirmed before launch. Nothing here implies a current relationship.'}
      </p>
    )
  }
</div>
