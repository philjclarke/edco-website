---
/*
  A Prismic page's sections, in the order the editor arranged them.

  Section slices (statement, figures, page cards …) render their own
  full-width section. Quotes are full-width shout-out bands. Runs of other sections between them
  share one background so they read as one part of the page; an empty quote
  shows a mock while MOCK_PROOF is on. How we do it is a route where each
  step links to where it's done.
*/
import type { Slice } from '@prismicio/client';
import Blocks from './Blocks.astro';
import ShoutOut from './ShoutOut.astro';
import Section from './Section.astro';
import RouteSteps from './RouteSteps.astro';
import SectionSlice from './sections/SectionSlice.astro';
import { SECTION_SLICE_TYPES } from './sections/tone';
import { blockOf } from '@/lib/slices';
import { hrefOf, textOf } from '@/lib/prismic';
import type { Block } from '@/data/blocks';

interface Props {
  slices: Slice[];
  /**
   * One wrapper per slice, never merged — for Prismic's slice simulator,
   * which maps each child of the slice zone to one slice.
   */
  separate?: boolean;
}
const { slices, separate = false } = Astro.props;

type Part =
  | { kind: 'blocks'; blocks: Block[] }
  | { kind: 'quote'; n: number; text: string; sub: string }
  | { kind: 'route'; heading: string; intro: string; steps: string[]; hrefs: (string | null)[] }
  | { kind: 'section'; slice: Slice };

const parts: Part[] = [];
let quotes = 0;
for (const s of slices) {
  const p = s.primary as Record<string, any>;
  if (SECTION_SLICE_TYPES.has(s.slice_type)) {
    parts.push({ kind: 'section', slice: s });
  } else if (s.slice_type === 'quote') {
    parts.push({ kind: 'quote', n: ++quotes, text: textOf(p.text), sub: textOf(p.supporting_line) });
  } else if (s.slice_type === 'how_we_do_it') {
    const steps = (p.steps ?? []).filter((x: any) => textOf(x.label));
    parts.push({
      kind: 'route',
      heading: textOf(p.heading),
      intro: textOf(p.intro),
      steps: steps.map((x: any) => textOf(x.label)),
      hrefs: steps.map((x: any) => hrefOf(x.link)),
    });
  } else {
    const b = blockOf(s);
    if (!b) continue;
    const last = parts[parts.length - 1];
    if (!separate && last?.kind === 'blocks') last.blocks.push(b);
    else parts.push({ kind: 'blocks', blocks: [b] });
  }
}
---

{
  parts.map((part) => {
    const content =
      part.kind === 'section' ? (
        <SectionSlice slice={part.slice} />
      ) : part.kind === 'quote' ? (
        <ShoutOut n={part.n} text={part.text} sub={part.sub} />
      ) : part.kind === 'route' ? (
        <Section tone="light" size="md">
          <p class="eyebrow grad-text mb-4">How we do it</p>
          {part.heading && <h2 class="text-title">“{part.heading}”</h2>}
          {part.intro && <p class="mt-4 max-w-2xl text-ink-muted">{part.intro}</p>}
          <div class="mt-8">
            <RouteSteps steps={part.steps} hrefs={part.hrefs} />
          </div>
        </Section>
      ) : (
        <Blocks blocks={part.blocks} tone="paper" />
      );
    return separate ? <div>{content}</div> : content;
  })
}
