---
/*
  A page's components, in the order the editor arranged them in Prismic.

  Most components render their own full-width section. Runs of the plain
  content components (Explainer text, Features listing, Screenshots, Cards,
  Steps and Options) share one background so they read as
  one part of the page. An empty quote shows a mock while MOCK_PROOF is on.
*/
import type { Slice } from '@prismicio/client';
import Blocks from './Blocks.astro';
import ShoutOut from './ShoutOut.astro';
import Banner from './slices/Banner.astro';
import QuoteTwoColumn from './slices/QuoteTwoColumn.astro';
import OutcomeCards from './slices/OutcomeCards.astro';
import ContentListing from './slices/ContentListing.astro';
import HowWeDoIt from './slices/HowWeDoIt.astro';
import ArticleBody from './slices/ArticleBody.astro';
import ContactForm from './slices/ContactForm.astro';
import CustomerLogins from './slices/CustomerLogins.astro';
import TextImage from './slices/TextImage.astro';
import SectionSlice from './sections/SectionSlice.astro';
import { SECTION_SLICE_TYPES, toneOf } from './sections/tone';
import { blockOf } from '@/lib/slices';
import { textOf } from '@/lib/prismic';
import type { PageContext } from '@/lib/pages';
import type { Block } from '@/data/blocks';

interface Props {
  slices: Slice[];
  /** The page the components are on. Absent in the slice simulator. */
  context?: PageContext;
  /**
   * One wrapper per slice, never merged — for Prismic's slice simulator,
   * which maps each child of the slice zone to one slice.
   */
  separate?: boolean;
}
const { slices, context, separate = false } = Astro.props;

const OWN_SECTION: Record<string, any> = {
  banner: Banner,
  outcomes: OutcomeCards,
  content_listing: ContentListing,
  how_we_do_it: HowWeDoIt,
  contact_form: ContactForm,
  customer_logins: CustomerLogins,
  text_image: TextImage,
};

type Part =
  | { kind: 'blocks'; blocks: Block[] }
  | { kind: 'quote'; n: number; header: string; text: string; name: string; sub: string; tone: 'dark' | 'light' | 'mist' }
  | { kind: 'own'; slice: Slice; Component: any };

const parts: Part[] = [];
let quotes = 0;
for (const s of slices) {
  const p = s.primary as Record<string, any>;
  if (SECTION_SLICE_TYPES.has(s.slice_type)) {
    parts.push({ kind: 'own', slice: s, Component: SectionSlice });
  } else if (OWN_SECTION[s.slice_type]) {
    parts.push({ kind: 'own', slice: s, Component: OWN_SECTION[s.slice_type] });
  } else if (s.slice_type === 'quote' && s.variation === 'two_column') {
    parts.push({ kind: 'own', slice: s, Component: QuoteTwoColumn });
  } else if (s.slice_type === 'quote') {
    parts.push({ kind: 'quote', n: ++quotes, header: textOf(p.header), text: textOf(p.text), name: textOf(p.name), sub: textOf(p.footer), tone: toneOf(p.background ?? 'navy') });
  } else if (s.slice_type === 'text_block' && context?.preview.article) {
    parts.push({ kind: 'own', slice: s, Component: ArticleBody });
  } else {
    const b = blockOf(s);
    if (!b) continue;
    // A features listing on a grey or navy background stands on its own.
    const alone = 'tone' in b && b.tone !== undefined;
    const last = parts[parts.length - 1];
    if (!separate && !alone && last?.kind === 'blocks' && !last.blocks.some((x) => 'tone' in x && x.tone)) last.blocks.push(b);
    else parts.push({ kind: 'blocks', blocks: [b] });
  }
}
---

{
  parts.map((part) => {
    const content =
      part.kind === 'own' ? (
        part.Component === SectionSlice ? <SectionSlice slice={part.slice} /> : <part.Component slice={part.slice} context={context} />
      ) : part.kind === 'quote' ? (
        <ShoutOut n={part.n} header={part.header} text={part.text} name={part.name} sub={part.sub} tone={part.tone} />
      ) : (
        <Blocks blocks={part.blocks} tone="paper" />
      );
    return separate ? <div>{content}</div> : content;
  })
}
