---
/*
  The brand's faded-photo device for light sections: a photograph that
  dissolves into the page behind a section's header (component deck,
  slides 8 and 10). Purely decorative. Its parent must be positioned.
*/
import { srcsetOf, type RemoteImage } from '@/lib/prismic';

interface Props {
  image: RemoteImage;
  /** Inside a card the photo sits on the right; behind a section it fills the top. */
  placement?: 'section' | 'card';
}
const { image, placement = 'section' } = Astro.props;
const { src, srcset } = srcsetOf(image, [640, 1280, 1920]);
---

<img
  src={src}
  srcset={srcset}
  sizes={placement === 'card' ? '(min-width: 1024px) 40vw, 90vw' : '100vw'}
  alt=""
  aria-hidden="true"
  loading="lazy"
  class:list={[
    'pointer-events-none absolute -z-10 object-cover',
    placement === 'card'
      ? 'inset-y-0 right-0 h-full w-3/5 opacity-30 [mask-image:linear-gradient(to_left,black_20%,transparent)]'
      : 'inset-x-0 top-0 h-[26rem] w-full opacity-35 [mask-image:linear-gradient(to_bottom,black,transparent),linear-gradient(to_left,black_30%,transparent)] [mask-composite:intersect]',
  ]}
/>
