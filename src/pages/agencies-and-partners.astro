---
/* Brief §44–§45. The one audience that warrants its own route, because the
   commercial relationship is materially different. */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import NextSteps from '@/components/NextSteps.astro';
import Testimonial from '@/components/Testimonial.astro';
import CtaBand from '@/components/CtaBand.astro';
import Placeholder from '@/components/Placeholder.astro';
import TickList from '@/components/TickList.astro';

const capabilities = [
  'Education intelligence',
  'Research',
  'Educator recruitment',
  'Data',
  'Content',
  'Events',
  'Marketing',
  'Technology',
  'Programme delivery',
];
---

<Layout
  title="Agencies & Partners"
  description="Bring EdCo into your team when you need specialist education capability. Your client stays your client."
>
  <PageHero
    eyebrow="Agencies & Partners"
    title="You know your client. We know education."
    standfirst="Your client stays your client."
    lead="Bring EdCo into your team when you need specialist education capability. We can work visibly alongside you, under your brand, or quietly behind the scenes."
    size="lg"
  />

  <Section tone="light" size="lg">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-20">
      <div>
        <p class="eyebrow grad-text mb-4">Your client. Our education expertise.</p>
        <h2 class="text-display">What you can bring us in for</h2>
        <p class="mt-6 text-lead text-ink-muted">
          All of it, or one piece of it. White-label work is explicitly on the table — EdCo does not
          need to be the hero.
        </p>
      </div>
      <TickList items={capabilities} columns={2} />
    </div>
  </Section>

  <Section tone="dark" size="md">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mx-auto mb-8 h-1 w-16 rounded-full grad-rule"></div>
      <p class="font-display text-display font-bold">Your client stays your client.</p>
      <p class="mt-6 text-lead text-ondark-muted">
        We work alongside professional CSR agencies, marketing agencies and consultancies regularly.
        We are not trying to take ownership of your client relationship, and we’ll put that in
        writing if it helps.
      </p>
    </div>
  </Section>

  <!-- Brief §45: a modest partner section, not a directory. -->
  <Section tone="light" size="lg">
    <SectionHead
      eyebrow="Partner ecosystem"
      title="And we bring other specialists in too"
      lead="Where a piece of work needs expertise we don’t have, we’d rather find the right people than pretend."
    />
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        [1, 2, 3].map((n) => (
          <li class="rounded-card border border-line bg-paper p-6">
            <div class="mb-5 flex h-16 items-center">
              <Placeholder label="PARTNER LOGO" />
            </div>
            <Placeholder label="PARTNER NAME" note={`${n} of 3`} block />
            <p class="mt-3 text-sm text-ink-muted">
              <Placeholder label="ONE SENTENCE ON WHAT THEY ADD" />
            </p>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-xs text-ink-muted">Only approved relationships appear here.</p>
  </Section>

  <Section tone="mist" size="md">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-center">
      <div>
        <p class="eyebrow grad-text mb-4">Proof beside the claim</p>
        <h2 class="text-title">Ask an agency we’ve worked with.</h2>
      </div>
      <Testimonial prompt="EdCo feeling like part of the client team" />
    </div>
  </Section>

  <Section tone="light" size="md">
    <NextSteps
      links={[
        { label: 'Research', href: '/capabilities/research/', blurb: 'Including educator recruitment on its own.' },
        { label: 'Education IQ', href: '/products/education-iq/', blurb: 'Education intelligence for your client’s market.' },
        { label: 'What we do', href: '/capabilities/', blurb: 'Everything you could bring us in for.' },
      ]}
    />
  </Section>

  <CtaBand
    title="Got a client brief with education in it?"
    body="Tell us what your client is trying to achieve. We’ll tell you honestly whether we’re the right people, and what we’d bring."
  />
</Layout>
