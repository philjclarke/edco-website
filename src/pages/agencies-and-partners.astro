---
import copy from '@/data/copy/pages.json';
/* Brief §44–§45. The one audience that warrants its own route, because the
   commercial relationship is materially different. */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import NextSteps from '@/components/NextSteps.astro';
import Testimonial from '@/components/Testimonial.astro';
import CtaBand from '@/components/CtaBand.astro';
import Placeholder from '@/components/Placeholder.astro';
import TickList from '@/components/TickList.astro';

const capabilities = [
  'Education intelligence',
  'Research',
  'Educator recruitment',
  'Data',
  'Content',
  'Events',
  'Marketing',
  'Technology',
  'Programme delivery',
];
---

<Layout
  title={copy.agencies.metaTitle}
  description={copy.agencies.metaDescription}
>
  <PageHero
    eyebrow={copy.agencies.heroEyebrow}
    title={copy.agencies.heroTitle}
    standfirst={copy.agencies.heroStandfirst}
    lead={copy.agencies.heroLead}
    size="lg"
    banner={{ src: 'meeting-table', focus: 'left' }}
  />

  <Section tone="light" size="lg">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-20">
      <div>
        <p class="eyebrow grad-text mb-4">{copy.agencies.body}</p>
        <h2 class="text-display">{copy.agencies.heading}</h2>
        <p class="mt-6 text-lead text-ink-muted">{copy.agencies.body2}</p>
      </div>
      <TickList items={capabilities} columns={2} />
    </div>
  </Section>

  <Section tone="dark" size="md">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mx-auto mb-8 h-1 w-16 rounded-full grad-rule"></div>
      <p class="font-display text-display font-bold">{copy.agencies.body3}</p>
      <p class="mt-6 text-lead text-ondark-muted">{copy.agencies.body4}</p>
    </div>
  </Section>

  <!-- Brief §45: a modest partner section, not a directory. -->
  <Section tone="light" size="lg">
    <SectionHead
      eyebrow={copy.agencies.sectionEyebrow}
      title={copy.agencies.sectionTitle}
      lead={copy.agencies.sectionLead}
    />
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        [1, 2, 3].map((n) => (
          <li class="rounded-card border border-line bg-paper p-6">
            <div class="mb-5 flex h-16 items-center">
              <Placeholder label="PARTNER LOGO" />
            </div>
            <Placeholder label="PARTNER NAME" note={`${n} of 3`} block />
            <p class="mt-3 text-sm text-ink-muted">
              <Placeholder label="ONE SENTENCE ON WHAT THEY ADD" />
            </p>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-xs text-ink-muted">{copy.agencies.body5}</p>
  </Section>

  <Section tone="mist" size="md">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-center">
      <div>
        <p class="eyebrow grad-text mb-4">{copy.agencies.body6}</p>
        <h2 class="text-title">{copy.agencies.heading2}</h2>
      </div>
      <Testimonial prompt="EdCo feeling like part of the client team" />
    </div>
  </Section>

  <Section tone="light" size="md">
    <NextSteps
      links={[
        { label: 'Research', href: '/capabilities/research/', blurb: 'Including educator recruitment on its own.' },
        { label: 'Education IQ', href: '/products/education-iq/', blurb: 'Education intelligence for your client’s market.' },
        { label: 'Capabilities', href: '/capabilities/', blurb: 'Everything you could bring us in for.' },
      ]}
    />
  </Section>

  <CtaBand
    title={copy.agencies.ctaTitle}
    body={copy.agencies.ctaBody}
  />
</Layout>
