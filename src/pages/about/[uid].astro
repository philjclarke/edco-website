---
/* Pages below About. Built from their components in Prismic (type 'about_subpage'). */
import PageView from '@/components/PageView.astro';
import { pagesOf } from '@/lib/pages';

export async function getStaticPaths() {
  return (await pagesOf('about_subpage')).map((doc) => ({ params: { uid: doc.uid! }, props: { doc } }));
}

const { doc } = Astro.props;
---

<PageView doc={doc} />
