---
/* Brief §12–§20. Section order here is the brief's order and shouldn't be shuffled:
   the outcome-led proposition has to land before "One EdCo" or the products. */
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import ModelStrip from '@/components/ModelStrip.astro';
import StatGrid from '@/components/StatGrid.astro';
import LogoWall from '@/components/LogoWall.astro';
import CtaBand from '@/components/CtaBand.astro';
import Placeholder from '@/components/Placeholder.astro';
import { outcomes } from '@/data/outcomes';
import { proofStats } from '@/data/proof';
import { site } from '@/data/site';
import home from '@/data/copy/home.json';
import classroom from '@/assets/images/classroom.jpg';
import ribbon from '@/assets/brand/ribbon-1.png';
import ribbonWave from '@/assets/brand/ribbon-4.png';
---

<Layout
  title="home"
  description={home.meta.description}
>
  <!-- ============================ Hero ============================ -->
  <section class="relative overflow-hidden bg-navy-900 text-ondark">
    <!-- Image sits behind on desktop; the brand ribbon rides the seam. -->
    <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[52%] lg:block">
      <Image
        src={classroom}
        alt=""
        aria-hidden="true"
        widths={[900, 1400, 1800]}
        sizes="52vw"
        class="h-full w-full object-cover object-left"
      />
      <div
        class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-navy-900)_0%,rgba(15,20,33,0.85)_18%,rgba(15,20,33,0)_58%)]"
      >
      </div>
    </div>
    <Image
      src={ribbon}
      alt=""
      aria-hidden="true"
      widths={[400, 800]}
      sizes="(min-width: 1024px) 360px, 200px"
      class="pointer-events-none absolute -top-32 right-[-10%] h-[150%] w-auto opacity-20 lg:right-[18%] lg:opacity-95"
    />

    <div class="relative mx-auto max-w-7xl px-6 py-20 md:py-28 lg:py-36">
      <div class="max-w-2xl">
        <p class="eyebrow mb-6 text-ondark-muted">{home.hero.eyebrow}</p>
        <h1 class="text-hero">{home.hero.heading}</h1>
        <p class="mt-7 font-display text-lead font-semibold grad-text">{home.hero.standfirst}</p>
        <p class="mt-6 max-w-xl text-lead text-ondark-muted">{home.hero.body}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={site.primaryCta.href} size="lg">{site.primaryCta.label}</Button>
          <Button href={site.secondaryCta.href} size="lg" variant="ghost-dark">
            {site.secondaryCta.label}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= Schools need partners, not vendors ================= -->
  <Section tone="light" size="lg">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-20">
      <div>
        <p class="eyebrow grad-text mb-4">{home.partners.eyebrow}</p>
        <h2 class="text-display">{home.partners.heading}</h2>
      </div>
      <div class="text-lead text-ink-muted">
        <p>{home.partners.body1}</p>
        <p class="mt-5">{home.partners.body2}</p>
        <p class="mt-5 font-display font-semibold text-ink">{home.partners.close}</p>
      </div>
    </div>
  </Section>

  <!-- ========================= How EdCo works ========================= -->
  <Section tone="dark" size="lg" id="how-edco-works" class="overflow-hidden">
    <Image
      src={ribbonWave}
      alt=""
      aria-hidden="true"
      widths={[900]}
      sizes="900px"
      class="pointer-events-none absolute -right-40 -top-20 w-[900px] max-w-none opacity-[0.14]"
    />
    <SectionHead
      eyebrow={home.howItWorks.eyebrow}
      title={home.howItWorks.heading}
      lead={home.howItWorks.lead}
      tone="dark"
    />
    <div class="mt-14">
      <ModelStrip tone="dark" />
    </div>
    <p class="mt-10 font-display text-title">
      {home.howItWorks.closeLead}<span class="grad-text">{home.howItWorks.closeEmphasis}</span>.
    </p>
    <p class="mt-4 max-w-2xl text-ondark-muted">{home.howItWorks.closeBody}</p>
  </Section>

  <!-- ================ What are you trying to achieve? ================ -->
  <Section tone="light" size="lg">
    <SectionHead
      eyebrow={home.outcomes.eyebrow}
      title={home.outcomes.heading}
      lead={home.outcomes.lead}
    />
    <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        outcomes.map((o, i) => (
          <li>
            <Card
              href={`/${o.slug}/`}
              index={i + 1}
              title={o.navLabel}
              body={o.summary}
              meta={home.outcomes.cardCta}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ============================ One EdCo ============================ -->
  <Section tone="mist" size="lg">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="text-display">{home.oneEdco.heading}</h2>
        <p class="mt-6 text-lead text-ink-muted">{home.oneEdco.lead}</p>
        <div class="mt-8">
          <Button href="/what-are-you-trying-to-achieve/" variant="ghost">
            {home.oneEdco.cta}
          </Button>
        </div>
      </div>
      <ul class="flex flex-wrap gap-2.5">
        {
          home.oneEdco.words.map((w) => (
            <li class="rounded-full border border-line bg-paper px-5 py-2.5 font-display text-base font-semibold">
              {w}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- ======================= Why breadth matters ======================= -->
  <Section tone="light" size="lg">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
      <div>
        <p class="eyebrow grad-text mb-4">{home.breadth.eyebrow}</p>
        <h2 class="text-display">{home.breadth.heading}</h2>
      </div>
      <div>
        <ul class="divide-y divide-line border-y border-line">
          {
            home.breadth.comparisons.map((c) => (
              <li class="flex flex-wrap gap-x-2 py-4">
                <span class="font-display font-semibold">{c.who}</span>
                <span class="text-ink-muted">{c.what}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 font-display text-title">{home.breadth.turn}</p>
        <p class="mt-4 text-lead text-ink-muted">{home.breadth.body}</p>
        <p class="mt-4 text-lead font-medium text-ink">{home.breadth.close}</p>
      </div>
    </div>
  </Section>

  <!-- ============================= Proof ============================= -->
  <Section tone="dark" size="lg">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow grad-text mb-4">{home.proof.eyebrow}</p>
        <h2 class="text-display">{home.proof.heading}</h2>
      </div>
      <div class="text-lead text-ondark-muted">
        <p>
          {home.proof.bodyBefore} <Placeholder label="VERIFIED METRIC" note="28 years" />
          {home.proof.bodyAfter}
        </p>
        <p class="mt-5">{home.proof.body2}</p>
      </div>
    </div>
    <div class="mt-14">
      <StatGrid stats={proofStats} tone="dark" />
    </div>
  </Section>

  <!-- ========================= Customer logos ========================= -->
  <Section tone="light" size="md">
    <SectionHead
      title={home.logos.heading}
      lead={home.logos.lead}
      align="center"
    />
    <div class="mt-12">
      <LogoWall />
    </div>
  </Section>

  <!-- ======================= What we're hearing ======================= -->
  <Section tone="mist" size="lg">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHead
        eyebrow={home.hearing.eyebrow}
        title={home.hearing.heading}
        lead={home.hearing.lead}
        class="flex-1"
      />
      <Button href="/what-we-think/what-were-hearing/" variant="ghost">{home.hearing.cta}</Button>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        [1, 2, 3].map((n) => (
          <li>
            <Card eyebrow="What we’re hearing" title="">
              <div class="space-y-3">
                <Placeholder label="CURRENT WHAT WE’RE HEARING ITEM" note={`slot ${n}`} block />
                <p class="text-sm text-ink-muted">{home.hearing.cardNote}</p>
              </div>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- =========================== Free value =========================== -->
  <Section tone="light" size="lg">
    <SectionHead
      eyebrow={home.freeValue.eyebrow}
      title={home.freeValue.heading}
      lead={home.freeValue.lead}
    />
    <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <li>
        <Card
          href="/free-customer-analysis/"
          eyebrow={home.freeValue.featured.eyebrow}
          title={home.freeValue.featured.title}
          body={home.freeValue.featured.body}
          meta={home.freeValue.featured.cta}
        />
      </li>
      {
        ['CURRENT RESEARCH', 'CURRENT GUIDE OR BRIEFING', 'CURRENT EVENT', 'CURRENT DIAGNOSTIC OR TOOL'].map(
          (label) => (
            <li>
              <Card title="" tone="light">
                <Placeholder label={label} block />
              </Card>
            </li>
          )
        )
      }
    </ul>
  </Section>

  <CtaBand />
</Layout>
