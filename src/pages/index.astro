---
/* The homepage (brief §12–§20). Built from its components in Prismic (type "home_page"). */
import PageView from '@/components/PageView.astro';
import { pages } from '@/lib/pages';

const doc = (await pages(Astro.locals)).single('home_page');
if (!doc) throw new Error('No home_page page in Prismic.');
---

<PageView doc={doc} />
