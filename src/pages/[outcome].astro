---
/* Brief §21–§26. The six outcome pages sit at the root, as specified in the
   sitemap (§11) — /understand-education-and-educators/, not /outcomes/…. */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import CtaBand from '@/components/CtaBand.astro';
import RouteSteps from '@/components/RouteSteps.astro';
import SectionTemplate from '@/components/SectionTemplate.astro';
import { outcomes } from '@/data/outcomes';
import { routes } from '@/data/model';
import type { Block } from '@/data/blocks';

export function getStaticPaths() {
  return outcomes.map((o) => ({ params: { outcome: o.slug }, props: { outcome: o } }));
}

const { outcome } = Astro.props;
const others = outcomes.filter((o) => o.slug !== outcome.slug);

// Brief §71: each outcome names the joined-up route that illustrates it.
// Matching on words in the label picked the wrong route, so it's explicit.
const matchedRoute = routes.find((r) => r.objective === outcome.routeObjective)!;

// Outcome copy has its own fields; put them in the template's terms.
const blocks: Block[] = [
  { slot: 'context', type: 'prose', paras: outcome.intro },
  {
    slot: 'problems',
    type: 'list',
    title: outcome.helpTitle,
    items: outcome.help,
    icons: outcome.helpIcons,
    columns: 2,
  },
];
---

<Layout title={outcome.navLabel} description={outcome.summary}>
  <PageHero
    parent={{ label: 'What are you trying to achieve?', href: '/what-are-you-trying-to-achieve/' }}
    eyebrow={outcome.navLabel}
    title={outcome.title}
    standfirst={outcome.standfirst}
    lead={outcome.lead}
    banner={outcome.banner}
    size="lg"
  />

  <SectionTemplate
    kind="achieve"
    blocks={blocks}
    shouts={outcome.shouts}
    testimonialTheme="EdCo challenging the original brief"
    related={others.map((o) => ({ label: o.navLabel, href: `/${o.slug}/`, blurb: o.summary }))}
  >
    <!-- How we do it: a worked example of the route, where every step links
         to the place it's done (brief §70, §71). -->
    <Section slot="how" tone="light" size="md">
      <p class="eyebrow grad-text mb-4">How we do it</p>
      <h2 class="text-title">“{matchedRoute.objective}”</h2>
      <p class="mt-4 max-w-2xl text-ink-muted">
        One example of how it could come together — not a fixed process. Each step takes you to
        where we do it.
      </p>
      <div class="mt-8">
        <RouteSteps steps={matchedRoute.steps} hrefs={matchedRoute.stepHrefs} />
      </div>
    </Section>
  </SectionTemplate>

  <CtaBand />
</Layout>
