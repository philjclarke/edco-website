---
/* Brief §21–§26. The six outcome pages sit at the root, as specified in the
   sitemap (§11) — /understand-education-and-educators/, not /outcomes/…. */
import PrismicPage from '@/components/PrismicPage.astro';
import { outcomes } from '@/data/outcomes';

export async function getStaticPaths() {
  return outcomes.map((o) => ({ params: { outcome: o.slug }, props: { page: o } }));
}

const { page } = Astro.props;
---

<PrismicPage
  page={page}
  section={{ label: 'What are you trying to achieve?', href: '/what-are-you-trying-to-achieve/' }}
/>
