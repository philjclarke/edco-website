---
/* Brief §21–§26. The outcome pages sit at the root, as the sitemap (§11) specifies. Built from their components in Prismic (type 'outcome'). */
import PageView from '@/components/PageView.astro';
import { pagesOf } from '@/lib/pages';

export async function getStaticPaths() {
  return (await pagesOf('outcome')).map((doc) => ({ params: { outcome: doc.uid! }, props: { doc } }));
}

const { doc } = Astro.props;
---

<PageView doc={doc} />
