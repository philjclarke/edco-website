---
/* Capability pages. Built from their components in Prismic (type 'capability'). */
import PageView from '@/components/PageView.astro';
import { pagesOf } from '@/lib/pages';

export async function getStaticPaths() {
  return (await pagesOf('capability')).map((doc) => ({ params: { slug: doc.uid! }, props: { doc } }));
}

const { doc } = Astro.props;
---

<PageView doc={doc} />
