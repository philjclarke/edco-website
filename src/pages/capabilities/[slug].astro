---
import PrismicPage from '@/components/PrismicPage.astro';
import { capabilityPages } from '@/data/capabilities';

export async function getStaticPaths() {
  return capabilityPages.map((c) => ({ params: { slug: c.slug }, props: { page: c } }));
}

const { page } = Astro.props;
---

<PrismicPage page={page} section={{ label: 'Capabilities', href: '/capabilities/' }} />
