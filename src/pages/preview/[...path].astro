---
/*
  The draft version of any page, rendered on request with content from the
  editor's Prismic preview session.

  It sets Astro.locals.prismicPreview, which tells the rest of the site to
  read content at the preview's ref (src/lib/content.ts, src/lib/pages.ts)
  and makes the layout add Prismic's toolbar, a "Preview" bar and noindex.
  Then it renders the same template the published page uses.

  Reached through /api/preview, never linked. With no preview session it
  sends you to the published page.
*/
import PageView from '@/components/PageView.astro';
import CaseStudyView from '@/components/CaseStudyView.astro';
import { prismic } from '@/lib/prismic';
import { pages } from '@/lib/pages';
import { caseStudyEntry } from '@/lib/editorial';
import CaseStudiesHub from '../case-studies/index.astro';
import Search from '../search.astro';
import NotFound from '../404.astro';

export const prerender = false;

const path = `/${Astro.params.path ?? ''}`.replace(/\/?$/, '/');
const ref = Astro.cookies.get(prismic.cookie.preview)?.value;
if (!ref) return Astro.redirect(path);

Astro.locals.prismicPreview = { ref, path };
Astro.response.headers.set('Cache-Control', 'private, no-store');

// Pages still built from fixed fields rather than components.
const SINGLE: Record<string, any> = {
  '/case-studies/': CaseStudiesHub,
  '/search/': Search,
  '/404/': NotFound,
};

const doc = SINGLE[path] ? undefined : (await pages(Astro.locals)).byHref.get(path);
if (!SINGLE[path] && !doc) {
  return new Response('This page isn’t in the current preview. Open the preview from Prismic again.', { status: 404 });
}
const Single = SINGLE[path];
---

{Single && <Single />}
{doc && doc.type === 'case_study' && <CaseStudyView study={caseStudyEntry(doc)} html={caseStudyEntry(doc).html} />}
{doc && doc.type !== 'case_study' && <PageView doc={doc} />}
