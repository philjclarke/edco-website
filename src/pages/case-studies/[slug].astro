---
import { getCollection } from 'astro:content';
import CaseStudyView from '@/components/CaseStudyView.astro';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props;
---

<CaseStudyView study={study} html={study.rendered?.html ?? ''} />
