---
import copy from '@/data/copy/pages.json';
/* Brief §56–§57. Organised around what the customer was trying to achieve,
   never around EdCo's internal departments. */
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import CtaBand from '@/components/CtaBand.astro';
import Placeholder from '@/components/Placeholder.astro';
import { caseStudyThemes } from '@/data/proof';
import { outcomes } from '@/data/outcomes';

const studies = await getCollection('caseStudies');
const outcomeLabel = (slug: string) =>
  outcomes.find((o) => o.slug === slug)?.navLabel ?? slug;
---

<Layout
  title={copy.caseStudies.metaTitle}
  description={copy.caseStudies.metaDescription}
>
  <PageHero
    eyebrow={copy.caseStudies.heroEyebrow}
    title={copy.caseStudies.heroTitle}
    standfirst={copy.caseStudies.heroStandfirst}
    lead={copy.caseStudies.heroLead}
    banner={{ src: 'meeting-table', focus: 'centre' }}
  />

  <Section tone="light" size="lg">
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        studies.map((s) => (
          <li>
            <Card
              href={`/case-studies/${s.id}/`}
              eyebrow={outcomeLabel(s.data.outcome)}
              title={s.data.title}
              body={s.data.summary}
              meta="Read the case"
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="mist" size="lg">
    <div class="max-w-3xl">
      <p class="eyebrow grad-text mb-4">Still to source</p>
      <h2 class="text-display">{copy.caseStudies.heading}</h2>
      <p class="mt-6 text-lead text-ink-muted">{copy.caseStudies.body}</p>
    </div>
    <ul class="mt-10 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2">
      {
        caseStudyThemes.map((t) => (
          <li class="flex items-center justify-between gap-4 bg-paper px-6 py-4">
            <span class="text-[0.9375rem]">{t}</span>
            <Placeholder label="TO SOURCE" />
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBand />
</Layout>
