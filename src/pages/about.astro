---
import copy from '@/data/copy/pages.json';
/* Brief §61–§63. Lead with beliefs, not a corporate timeline.
   No careers section — recruitment is handled elsewhere. */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import StatGrid from '@/components/StatGrid.astro';
import NextSteps from '@/components/NextSteps.astro';
import CtaBand from '@/components/CtaBand.astro';
import Placeholder from '@/components/Placeholder.astro';
import Grid from '@/components/Grid.astro';
import { beliefs } from '@/data/model';
import { proofStats } from '@/data/proof';
---

<Layout
  title={copy.about.metaTitle}
  description={copy.about.metaDescription}
>
  <PageHero
    eyebrow={copy.about.heroEyebrow}
    title={copy.about.heroTitle}
    standfirst={copy.about.heroStandfirst}
    lead={copy.about.heroLead}
    size="lg"
    banner={{ src: 'lecture-hall', focus: 'centre' }}
  />

  <Section tone="light" size="lg">
    <Grid cols={2} as="ul">
      {
        beliefs.map((b, i) => (
          <li class="p-7 md:p-8">
            <span class="font-display text-sm font-bold grad-text">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2 class="mt-3 font-display text-lg font-bold leading-snug md:text-xl">{b.title}</h2>
            <p class="mt-3 text-ink-muted">{b.body}</p>
          </li>
        ))
      }
    </Grid>
  </Section>

  <!-- Brief §62: heritage as evidence, not the main proposition. -->
  <Section tone="dark" size="lg">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow grad-text mb-4">Heritage</p>
        <h2 class="text-display">{copy.about.heading}</h2>
      </div>
      <div class="text-lead text-ondark-muted">
        <p>{copy.about.body}</p>
        <p class="mt-5">{copy.about.body2}</p>
      </div>
    </div>
    <div class="mt-14">
      <StatGrid stats={proofStats} tone="dark" />
    </div>
  </Section>

  <!-- Brief §63: people as evidence of expertise, not a wall of 50 biographies. -->
  <Section tone="light" size="lg">
    <SectionHead
      eyebrow={copy.about.sectionEyebrow}
      title={copy.about.sectionTitle}
      lead={copy.about.sectionLead}
    />
    <Grid cols={4} class="mt-12">
      {
        ['LEADERSHIP PROFILE', 'LEADERSHIP PROFILE', 'LEADERSHIP PROFILE', 'LEADERSHIP PROFILE'].map(
          (label, i) => (
            <div class="p-6">
              <div class="mb-5 aspect-square rounded-lg bg-mist" />
              <Placeholder label={label} note={`${i + 1} of 4`} block />
              <p class="mt-3 text-sm text-ink-muted">{copy.about.body3}</p>
            </div>
          )
        )
      }
    </Grid>
    <p class="mt-6">
      <Placeholder label="MEET EDCO" note="broader team area — phase 2" />
    </p>
  </Section>

  <!-- Brief §60. -->
  <Section tone="mist" size="lg">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow grad-text mb-4">{copy.about.body4}</p>
        <h2 class="text-display">{copy.about.heading2}</h2>
      </div>
      <div class="text-lead text-ink-muted">
        <p>{copy.about.body5}</p>
        <p class="mt-5">{copy.about.body6}</p>
      </div>
    </div>
  </Section>

  <Section tone="light" size="md">
    <NextSteps
      links={[
        { label: 'What We Think', href: '/what-we-think/', blurb: 'The beliefs, argued in public.' },
        { label: 'Case studies', href: '/case-studies/', blurb: 'The beliefs, applied to real work.' },
        { label: 'Agencies & Partners', href: '/agencies-and-partners/', blurb: 'How we work alongside other agencies.' },
      ]}
    />
  </Section>

  <CtaBand />
</Layout>
