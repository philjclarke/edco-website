---
import copy from '@/data/copy/pages.json';
/* Brief §11, §13. The overview of the six outcome routes. */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import CtaBand from '@/components/CtaBand.astro';
import ProcessGrid from '@/components/ProcessGrid.astro';
import { outcomes } from '@/data/outcomes';
import { routes } from '@/data/model';
---

<Layout
  title={copy.outcomesHub.metaTitle}
  description={copy.outcomesHub.metaDescription}
>
  <PageHero
    eyebrow={copy.outcomesHub.heroEyebrow}
    title={copy.outcomesHub.heroTitle}
    standfirst={copy.outcomesHub.heroStandfirst}
    lead={copy.outcomesHub.heroLead}
    size="lg"
    banner={{ src: 'teacher-board', focus: 'centre' }}
  />

  <Section tone="light" size="lg">
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        outcomes.map((o, i) => (
          <li>
            <Card
              href={`/${o.slug}/`}
              icon={o.icon}
              index={i + 1}
              title={o.navLabel}
              body={o.summary}
              meta={o.standfirst}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Brief §72: the agency comparison, used here to explain breadth. -->
  <Section tone="dark" size="lg">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow grad-text mb-4">Why we start here</p>
        <h2 class="text-display">{copy.outcomesHub.heading}</h2>
      </div>
      <div class="text-lead text-ondark-muted">
        <p>{copy.outcomesHub.body}</p>
        <p class="mt-5">{copy.outcomesHub.body2}</p>
        <p class="mt-5 font-display font-semibold text-ondark">{copy.outcomesHub.body3}</p>
      </div>
    </div>
  </Section>

  <!-- Brief §71: real objectives, and one way EdCo might approach each. -->
  <Section tone="light" size="lg">
    <h2 class="text-display">{copy.outcomesHub.heading2}</h2>
    <ul class="mt-12 space-y-px overflow-hidden rounded-card border border-line bg-line">
      {
        routes.map((r) => (
          <li class="bg-paper p-6 md:p-8">
            <p class="font-display text-lg font-semibold md:text-xl">“{r.objective}”</p>
            <div class="mt-5">
              <ProcessGrid steps={r.steps} />
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 max-w-2xl text-ink-muted">{copy.outcomesHub.body4}</p>
  </Section>

  <CtaBand />
</Layout>
