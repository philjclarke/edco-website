---
/* Brief §46. The umbrella area for EdCo's public thinking. */
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Placeholder from '@/components/Placeholder.astro';
import { streams } from '@/data/streams';

const all = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="What We Think"
  description="What we’re hearing from educators, what we think about it, and the research underneath."
>
  <PageHero
    eyebrow="What We Think"
    title="Listening, out loud."
    standfirst="Worth knowing. Occasionally worth arguing about."
    lead="Three different things, kept deliberately separate: what the sector is telling us, what we think about it, and what the evidence actually says."
    banner={{ src: 'lecture-hall', focus: 'right' }}
  />

  <Section tone="light" size="lg">
    <ul class="grid gap-5 md:grid-cols-3">
      {
        streams.map((s) => (
          <li>
            <a
              href={`/what-we-think/${s.slug}/`}
              class="group flex h-full flex-col rounded-card border border-line bg-paper p-7 transition hover:border-ink/25 hover:shadow-lg hover:shadow-navy-900/5"
            >
              <p class="eyebrow grad-text mb-3">{s.label}</p>
              <h2 class="font-display text-xl font-bold leading-snug">“{s.question}”</h2>
              <p class="mt-3 text-sm text-ink-muted">{s.note}</p>
              <span class="mt-auto pt-5 text-sm font-medium grad-text">Read this stream →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="mist" size="lg">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-display">Most recent</h2>
      <p><Placeholder label="EDITORIAL PIPELINE" note="volume and cadence to agree" /></p>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {all.map((a) => <li><ArticleCard article={a} /></li>)}
    </ul>
  </Section>

  <CtaBand
    title="Keep listening with us."
    body="Get the most useful things we’re hearing from educators, new research, EdCo opinion and invitations to events. No generic education-news roundup."
    ctaLabel="Subscribe"
    ctaHref="/contact/"
  />
</Layout>
