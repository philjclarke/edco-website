---
import { getCollection } from 'astro:content';
import ArticleView from '@/components/ArticleView.astro';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map((article) => ({
    params: { stream: article.data.stream, slug: article.id },
    props: {
      article,
      // Newest first, so the order doesn't depend on how the CMS returns them.
      related: all
        .filter((a) => a.id !== article.id)
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
        .slice(0, 3),
    },
  }));
}

const { article, related } = Astro.props;
---

<ArticleView article={article} html={article.rendered?.html ?? ''} related={related} />
