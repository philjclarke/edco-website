---
/* Contact (brief §68). The form is the Contact form component. Built from its components in Prismic (type "contact_page"). */
import PageView from '@/components/PageView.astro';
import { pages } from '@/lib/pages';

const doc = (await pages(Astro.locals)).single('contact_page');
if (!doc) throw new Error('No contact_page page in Prismic.');
---

<PageView doc={doc} />
