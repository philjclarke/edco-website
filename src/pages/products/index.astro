---
/* Brief §27. Products come after the broader proposition, never before it. Built from its components in Prismic (type "products_hub"). */
import PageView from '@/components/PageView.astro';
import { pages } from '@/lib/pages';

const doc = (await pages(Astro.locals)).single('products_hub');
if (!doc) throw new Error('No products_hub page in Prismic.');
---

<PageView doc={doc} />
