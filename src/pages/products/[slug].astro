---
import PrismicPage from '@/components/PrismicPage.astro';
import { products } from '@/data/products';

export async function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props;
---

<PrismicPage page={page} section={{ label: 'Products', href: '/products/' }} />
