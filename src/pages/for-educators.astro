---
/* For Educators (brief §54): a route for educators who arrive, without turning the corporate site into an educator site. Built from its components in Prismic (type "for_educators_page"). */
import PageView from '@/components/PageView.astro';
import { pages } from '@/lib/pages';

const doc = (await pages(Astro.locals)).single('for_educators_page');
if (!doc) throw new Error('No for_educators_page page in Prismic.');
---

<PageView doc={doc} />
