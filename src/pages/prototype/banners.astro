---
/*
  Not part of the site. A comparison page for two decisions: how banner
  photography is treated, and how icons are used.

  Deliberately not in the navigation, not in the sitemap, and noindex — delete
  the file once both are settled.
*/
import { Icon } from 'astro-icon/components';
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import BannerImage from '@/components/BannerImage.astro';
import Grid from '@/components/Grid.astro';
import Card from '@/components/Card.astro';

const variants = [
  {
    id: 'fade',
    name: 'Fade',
    note: 'The photo dissolves into the navy on its left edge. Nothing to align, works with any crop.',
    props: { treatment: 'fade' as const, src: 'students-laptops', focus: 'right' as const },
  },
  {
    id: 'fade-duotone',
    name: 'Fade + duotone',
    note: 'Same edge, but the brand gradient is blended through the photo. Pulls any stock shot onto the palette.',
    props: { treatment: 'fade' as const, duotone: true, src: 'students-laptops', focus: 'right' as const },
  },
  {
    id: 'shape',
    name: 'Shape',
    note: 'Clipped into a curve echoing the ribbon. Defined in relative units, so it scales rather than being a fixed asset.',
    props: { treatment: 'shape' as const, src: 'primary-classroom', focus: 'centre' as const },
  },
  {
    id: 'shape-duotone',
    name: 'Shape + duotone',
    note: 'The most branded of the four, and the furthest from a photograph.',
    props: { treatment: 'shape' as const, duotone: true, src: 'primary-classroom', focus: 'centre' as const },
  },
];

/* Icons carrying meaning rather than decorating — one per EdCo capability. */
const iconExamples = [
  { icon: 'fa6-solid:magnifying-glass', label: 'Research', note: 'Ask educators rather than guess' },
  { icon: 'fa6-solid:chart-simple', label: 'Education IQ', note: 'Understand where need exists' },
  { icon: 'fa6-solid:calendar-day', label: 'Events & CPD', note: 'Live, on-demand and after' },
  { icon: 'fa6-solid:bullhorn', label: 'Marketing', note: 'Reach the right educators' },
  { icon: 'fa6-solid:database', label: 'Data Services', note: 'The foundation underneath' },
  { icon: 'fa6-solid:code', label: 'Technology', note: 'Where technology is the answer' },
];
---

<Layout title="Prototype — banners & icons" description="Internal comparison page.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <Section tone="mist" size="sm">
    <p class="eyebrow grad-text mb-3">Internal</p>
    <h1 class="text-display">Banner treatments &amp; icons</h1>
    <p class="mt-5 max-w-2xl text-lead text-ink-muted">
      Four ways to treat hero photography, and a first pass at discreet icon use. Not linked from
      the site and set to noindex — this page gets deleted once both are decided.
    </p>
  </Section>

  {
    variants.map((v) => (
      <>
        <div class="border-y border-line bg-mist">
          <div class="mx-auto flex max-w-7xl flex-wrap items-baseline gap-x-4 gap-y-1 px-6 py-3">
            <span class="font-display text-sm font-bold">{v.name}</span>
            <span class="text-sm text-ink-muted">{v.note}</span>
          </div>
        </div>
        <section class="relative overflow-hidden bg-navy-900 text-ondark">
          <BannerImage {...v.props} />
          <div class="relative mx-auto max-w-7xl px-6 pb-20 pt-12 md:pb-24 md:pt-16">
            <div class="max-w-xl">
              <p class="eyebrow mb-5 text-ondark-muted">Products</p>
              <h2 class="text-display">Start with the school, not the product.</h2>
              <p class="mt-6 font-display text-lead font-semibold grad-text">
                The right context, at the point it matters.
              </p>
              <p class="mt-5 text-lead text-ondark-muted">
                Education IQ helps organisations understand individual schools, trusts and the
                wider education sector so they can identify need and build better relationships.
              </p>
            </div>
          </div>
        </section>
      </>
    ))
  }

  <!-- ============================== Icons ============================== -->
  <Section tone="light" size="md">
    <p class="eyebrow grad-text mb-3">Icons</p>
    <h2 class="text-display">Discreet by default</h2>
    <p class="mt-5 max-w-2xl text-lead text-ink-muted">
      Inlined as SVG at build, inheriting <code class="font-mono text-[0.9em]">currentColor</code>,
      so they take the theme and the gradient without any extra work. Referenced by name, which
      means changing one is a text instruction rather than an asset request.
    </p>

    <h3 class="mt-12 font-display text-lg font-bold">In a grid — information</h3>
    <Grid cols={3} class="mt-5">
      {
        iconExamples.map((e) => (
          <div class="p-6">
            <Icon name={e.icon} class="mb-4 h-5 w-5 text-pink" />
            <p class="font-display text-base font-semibold">{e.label}</p>
            <p class="mt-1 text-sm text-ink-muted">{e.note}</p>
          </div>
        ))
      }
    </Grid>

    <h3 class="mt-14 font-display text-lg font-bold">In a panel — clickable</h3>
    <ul class="mt-5 grid gap-5 md:grid-cols-3">
      {
        iconExamples.slice(0, 3).map((e) => (
          <li>
            <Card href="/capabilities/" title={e.label} body={e.note} meta="Read about it">
              <span class="order-first mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-[linear-gradient(120deg,var(--color-orange),var(--color-pink))] text-white">
                <Icon name={e.icon} class="h-4 w-4" />
              </span>
            </Card>
          </li>
        ))
      }
    </ul>

    <h3 class="mt-14 font-display text-lg font-bold">At text size — inline</h3>
    <ul class="mt-5 space-y-2.5">
      {
        ['Works with the CRM you already have', 'No JavaScript shipped for any of this', 'Same icon set, light and dark'].map(
          (t) => (
            <li class="flex items-center gap-3 text-[0.9375rem]">
              <Icon name="fa6-solid:circle-check" class="h-3.5 w-3.5 shrink-0 text-pink" />
              {t}
            </li>
          )
        )
      }
    </ul>
  </Section>

  <Section tone="dark" size="md">
    <h2 class="text-title">The same icons on navy</h2>
    <Grid cols={3} tone="dark" class="mt-8">
      {
        iconExamples.map((e) => (
          <div class="p-6">
            <Icon name={e.icon} class="mb-4 h-5 w-5 text-orange" />
            <p class="font-display text-base font-semibold">{e.label}</p>
            <p class="mt-1 text-sm text-ondark-muted">{e.note}</p>
          </div>
        ))
      }
    </Grid>
  </Section>
</Layout>
