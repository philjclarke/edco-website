---
/* Customer login (brief §69). The logins are the Customer logins component. Built from its components in Prismic (type "customer_page"). */
import PageView from '@/components/PageView.astro';
import { pages } from '@/lib/pages';

const doc = (await pages(Astro.locals)).single('customer_page');
if (!doc) throw new Error('No customer_page page in Prismic.');
---

<PageView doc={doc} />
