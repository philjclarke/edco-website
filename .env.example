# The /admin publish console. Set these in the Vercel project's environment
# variables — none of them belong in the repo.

# Shared password for the admin area.
ADMIN_PASSWORD=

# Any long random string. Signs the admin session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Fine-grained personal access token, scoped to this repository only,
# with Contents: read and write. Nothing else.
GITHUB_TOKEN=
GITHUB_REPO=philjclarke/edco-website
GITHUB_BRANCH=main

# The copy deck, as CSV. Any link-shared Google Sheet serves this.
DECK_CSV_URL=https://docs.google.com/spreadsheets/d/1tIJqD10Xente09Q4pjejPsd7qyaYfcGevYmNA3Sbj4o/export?format=csv
