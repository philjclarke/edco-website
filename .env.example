# Local settings for the Prismic scripts. The site itself needs none of these
# to build: it reads published content from repository 66bbee42 by default.

# Point a build at another Prismic repository (e.g. a copy for testing).
PRISMIC_REPOSITORY=66bbee42

# Only for pushing content models from this machine (scripts/prismic.ts).
# Never add it to Vercel. Create one with:
#   npx prismic token create --write --repo 66bbee42
PRISMIC_WRITE_TOKEN=
